{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oasis7 Command Center",
  "version": "0.1.0",
  "identifier": "com.oasis7.command-center",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "Oasis7 指挥中心", "width": 1280, "height": 860, "minWidth": 640, "minHeight": 480}],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {"active": true, "targets": ["app", "dmg"], "icon": ["icons/icon.png"], "macOS": {"minimumSystemVersion": "11.0", "signingIdentity": "-"}}
}
