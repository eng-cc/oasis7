{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window has the finite project and experimental runtime bridge, plus lifecycle invalidation listeners. No arbitrary filesystem, shell, protocol or remote-origin access.",
  "windows": ["main"],
  "permissions": [
    "allow-open-project", "allow-query-view", "allow-search-rules",
    "allow-save-decision-draft", "allow-save-preference", "allow-read-source",
    "allow-refresh-source", "allow-rebuild-cache", "allow-refresh-github",
    "allow-get-github-snapshot", "allow-open-source-target", "allow-choose-project",
    "allow-associate-work", "allow-read-version",
    "allow-get-runtime", "allow-reconcile-runtime-operation", "allow-set-runtime-enabled", "allow-connect-runtime",
    "allow-create-runtime-session", "allow-continue-runtime-session", "allow-start-runtime-turn",
    "allow-steer-runtime-turn", "allow-interrupt-runtime-turn", "allow-answer-runtime-request",
    "allow-get-exit-status", "allow-request-exit-wait", "allow-request-exit-stop", "allow-cancel-exit-wait",
    "core:event:allow-listen", "core:event:allow-unlisten"
  ]
}
