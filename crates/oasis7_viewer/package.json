{
  "name": "oasis7-viewer-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:feedback-contract": "node ./scripts/software-safe-feedback-contract.test.mjs",
    "test:frontend-structure": "node ./scripts/frontend-structure-audit.mjs",
    "test:pixel-world:visual": "node ./scripts/pixel-world-hotspot-visual-smoke.mjs",
    "test:pixel-world:location-frame:visual": "node ./scripts/pixel-world-location-frame-visual-smoke.mjs",
    "test:pixel-world:module-visual": "node ./scripts/pixel-world-module-visual-smoke.mjs",
    "test:performance": "node ./scripts/viewer-performance-probe.mjs",
    "test:perf-harness": "vitest run software_safe_src/performance_metrics.test.js",
    "perf:viewer": "node ./scripts/viewer-performance-probe.mjs",
    "build:viewer:bundle": "vite build --config vite.software-safe.config.mjs",
    "build:viewer": "npm run build:viewer:bundle && node ./scripts/finalize-software-safe-build.mjs",
    "build:software-safe:bundle": "npm run build:viewer:bundle",
    "build:software-safe": "npm run build:viewer"
  },
  "dependencies": {
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^29.1.1",
    "vite": "^7.1.7",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^4.1.6"
  }
}
