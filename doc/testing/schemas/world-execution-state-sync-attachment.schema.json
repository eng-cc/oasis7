        "receipt_id",
        "receipt_core",
        "finality_binding"
      ],
      "additionalProperties": false
    },
    "PendingIntentV1": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "PendingIntentV1"
        },
        "scope": {
          "$ref": "#/$defs/WorldScopeV1"
        },
        "intent_id": {
          "$ref": "#/$defs/Id"
        },
        "request_hash": {
          "$ref": "#/$defs/Hash32"
        },
        "payload_hash": {
          "$ref": "#/$defs/Hash32"
        },
        "subject_id": {
          "$ref": "#/$defs/Id"
        },
        "target_hash": {
          "$ref": "#/$defs/Hash32"
        },
        "lineage_id": {
          "$ref": "#/$defs/Id"
        },
        "member_generation": {
          "$ref": "#/$defs/U64"
        },
        "relation": {
          "enum": [
            "original",
            "linked_replacement",
            "withdrawal",
            "independent"
          ]
        },
        "exclusive_set_id": {
          "$ref": "#/$defs/Id"
        },
        "predecessor_intent_id": {
          "$ref": "#/$defs/Id"
        },
        "predecessor_request_hash": {
          "$ref": "#/$defs/Hash32"
        },
        "compatibility_declaration_hash": {
          "$ref": "#/$defs/Hash32"
        },
        "accepted_position": {
          "$ref": "#/$defs/JournalPositionV1"
        },
        "expiry_boundary": {
          "$ref": "#/$defs/U64"
        },
        "disposition": {
          "const": "pending"
        }
      },
      "required": [
        "schema_version",
        "scope",
        "intent_id",
        "request_hash",
        "payload_hash",
        "subject_id",
        "target_hash",
        "lineage_id",
        "member_generation",
        "relation",
        "compatibility_declaration_hash",
        "accepted_position",
        "disposition"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "relation": {
                "enum": [
                  "linked_replacement",
                  "withdrawal"
                ]
              }
            },
            "required": [
              "relation"
            ]
          },
          "then": {
            "required": [
              "exclusive_set_id",
              "predecessor_intent_id",
              "predecessor_request_hash"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "predecessor_intent_id"
                  ]
                },
                {
                  "required": [
                    "predecessor_request_hash"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "IntentDecisionV1": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "IntentDecisionV1"
        },
        "scope": {
          "$ref": "#/$defs/WorldScopeV1"
        },
        "intent_id": {
          "$ref": "#/$defs/Id"
        },
        "request_hash": {
          "$ref": "#/$defs/Hash32"
        },
        "lineage_id": {
          "$ref": "#/$defs/Id"
        },
        "member_generation": {
          "$ref": "#/$defs/U64"
        },
        "disposition": {
          "enum": [
            "committed_effect",
            "rejected",
            "expired",
            "replan_required",
            "terminated_without_effect"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/Id"
        },
        "decision_position": {
          "$ref": "#/$defs/JournalPositionV1"
        },
        "execution_receipt_ref": {
          "$ref": "#/$defs/ContentRefV1"
        },
        "winner_intent_id": {
          "$ref": "#/$defs/Id"
        },
        "winner_receipt_ref": {
          "$ref": "#/$defs/ContentRefV1"
        }
      },
      "required": [
        "schema_version",
        "scope",
        "intent_id",
        "request_hash",
        "lineage_id",
        "member_generation",
        "disposition",
        "decision_position"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "committed_effect"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "execution_receipt_ref"
            ]
          },
          "else": {
            "required": [
              "reason_code"
            ],
            "not": {
              "required": [
                "execution_receipt_ref"
              ]
            }
          }
        },
        {
          "dependentRequired": {
            "winner_intent_id": [
              "winner_receipt_ref"
            ],
            "winner_receipt_ref": [
              "winner_intent_id"
            ]
          }
        }
      ]
    },
    "ExternalEffectReceiptV1": {
