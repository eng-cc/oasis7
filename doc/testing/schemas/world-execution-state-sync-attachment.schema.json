          "$ref": "#/$defs/Hash32"
        },
        "request_payload_hash": {
          "$ref": "#/$defs/Hash32"
        },
        "response_payload_hash": {
          "$ref": "#/$defs/Hash32"
        },
        "provider_proof": {
          "$ref": "#/$defs/ContentRefV1"
        },
        "canonical_inclusion": {
          "type": "object",
          "properties": {
            "canonical_block_hash": {
              "$ref": "#/$defs/Hash32"
            },
            "canonical_block_height": {
              "$ref": "#/$defs/U64"
            },
            "journal_position": {
              "$ref": "#/$defs/JournalPositionV1"
            },
            "receipts_root": {
              "$ref": "#/$defs/Hash32"
            },
            "authority_snapshot_hash": {
              "$ref": "#/$defs/Hash32"
            },
            "finality_proof": {
              "$ref": "#/$defs/ContentRefV1"
            }
          },
          "required": [
            "canonical_block_hash",
            "canonical_block_height",
            "journal_position",
            "receipts_root",
            "authority_snapshot_hash",
            "finality_proof"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "scope",
        "receipt_id",
        "effect_intent_id",
        "request_hash",
        "parent_execution_receipt_id",
        "provider_id",
