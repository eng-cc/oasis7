  "rules": [
    {
      "match": [
        "doc/**",
        "AGENTS.md",
        "*.md",
        ".agents/**"
      ],
      "groups": [],
      "reason": "documents"
    },
    {
      "match": [
        "doc/world-simulator/scenario/**",
        "crates/oasis7/scenarios/**",
        "crates/oasis7/src/simulator/scenario.rs",
        "crates/oasis7/tests/oasis7_init_demo.rs"
      ],
      "groups": [
        "scenario_regression"
      ],
      "reason": "scenario_inputs"
    },
    {
      "match": [
        "crates/oasis7_viewer/**"
      ],
      "groups": [
        "viewer_js_required"
      ],
      "reason": "viewer_assets"
    },
    {
      "match": [
        "site/**",
        "README.md",
        "doc/world-simulator/viewer/viewer-manual.manual.md",
        "scripts/site-*"
      ],
      "groups": [
        "site_quality"
      ],
      "reason": "site"
    },
    {
      "match": [
        "scripts/p2p-*",
        "scripts/provider-remote-https/**",
        "scripts/run-local-letai-game-test*",
        "scripts/game-world-state-sync*",
        "scripts/state-sync-closure*",
        "scripts/s10-*",
        "scripts/release-gate-*",
        "scripts/build-game-launcher-bundle*",
        "scripts/testnet-packages-linux*",
        "scripts/testnet-packages-windows*",
        "scripts/fixtures/oasis7-governance-root*"
      ],
      "groups": [
        "operational_contracts"
      ],
      "reason": "operational"
    },
    {
      "match": [
        "scripts/package-*",
        "scripts/native-packaging*",
        "scripts/packaging-*",
        "scripts/release-packages-trunk*",
        "scripts/testnet-packages-macos*",
        "scripts/validate-release-platform*"
      ],
      "groups": [
        "packaging_contracts"
      ],
      "reason": "packaging"
    },
    {
      "match": [
        "scripts/security/**"
      ],
      "groups": [
        "workflow_governance"
      ],
      "reason": "security"
    },
    {
      "match": [
        "scripts/doc-*",
        "scripts/document*",
        "scripts/product-doc-*",
        "scripts/product_doc*",
        "scripts/system-design-traceability*",
        "scripts/find-python-with-module*"
      ],
      "groups": [
        "doc_checker_contracts"
      ],
      "reason": "document_checker"
    },
    {
      "match": [
        "scripts/cargo-dev*",
        "scripts/check-standalone-tool-lockfiles*",
        "scripts/check-launcher-p2p-dependency*"
      ],
      "groups": [
        "cargo_tooling_contracts"
      ],
      "reason": "cargo_tools"
    },
    {
      "match": [
        "scripts/pr-review-thread-closeout*"
      ],
      "groups": [
        "workflow_governance"
      ],
      "reason": "operation_safety"
    },
    {
      "match": [
        ".codex/**",
        "scripts/validate-codex-agent-config*"
      ],
      "groups": [
        "codex_agent_config_validation"
      ],
      "reason": "codex_configuration"
    },
    {
      "match": [
        "scripts/build-viewer-*",
        "scripts/viewer-*",
        "scripts/copy-viewer-*",
        "scripts/bundle-freshness*",
        "scripts/agent-browser-*"
      ],
      "groups": [
        "viewer_js_required"
      ],
      "reason": "viewer_tools"
    },
    {
      "match": [
        "scripts/worktree-harness*",
        "scripts/launcher-help*"
      ],
      "groups": [
        "launcher_web"
      ],
      "reason": "launcher_tools"
    },
    {
      "match": [
        "scripts/check-script-executable-bits*",
        "scripts/check-windows-paths*",
        "scripts/lint-skills*",
        "scripts/pre-commit*"
      ],
      "groups": [
        "baseline"
      ],
      "reason": "baseline_tools"
    },
    {
      "match": [
        "crates/oasis7_viewer/scripts/viewer-performance*",
        "crates/oasis7_viewer/software_safe_src/performance*",
        "scripts/viewer-performance*"
      ],
      "groups": [
        "viewer_performance_report"
      ],
      "reason": "viewer_performance_report"
    },
    {
      "match": [
        "scripts/new-task-worktree*"
      ],
      "groups": [
        "cargo_tooling_contracts",
        "fleet_health"
      ],
      "reason": "worktree_bootstrap"
    },
    {
      "match": [
        "scripts/resource-cleanup*"
      ],
      "groups": [
        "workflow_governance",
        "fleet_health"
      ],
      "reason": "resource_cleanup"
    },
    {
      "match": [
        "scripts/worktree-gc-report*"
      ],
      "groups": [
        "workflow_governance"
      ],
      "reason": "worktree_report"
    },
    {
      "match": [
        "scripts/local-signer/tests/**",
        "doc/p2p/blockchain/local-file-signing-backend.runbook.md",
        "crates/oasis7_local_signer/**"
      ],
      "groups": [
        "packaging_contracts",
        "fleet_health"
      ],
      "reason": "local_signer_contracts"
    },
    {
      "match": [
        "scripts/local-signer/installer.py",
        "scripts/local-signer/macos_host.py",
        "scripts/local-signer/install-release.py",
        "scripts/local-signer/package-release.py"
      ],
      "groups": [
        "packaging_contracts",
        "fleet_health",
        "workspace_support"
      ],
      "reason": "local_signer_installation"
    }
  ]
}
