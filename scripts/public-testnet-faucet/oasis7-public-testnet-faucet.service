[Unit]
Description=oasis7 public testnet guarded faucet
After=network-online.target oasis7-testnet-sequencer.service
Wants=network-online.target

[Service]
Type=simple
User=oasis7-testnet
Group=oasis7-testnet
WorkingDirectory=/opt/oasis7/public-testnet-faucet/current
EnvironmentFile=/etc/oasis7/public-testnet-faucet.env
ExecStart=/opt/oasis7/public-testnet-faucet/current/scripts/public-testnet-faucet/start-public-testnet-faucet.sh
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/oasis7/public-testnet-faucet /etc/oasis7/public-testnet-faucet

[Install]
WantedBy=multi-user.target
