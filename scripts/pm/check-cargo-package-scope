#!/usr/bin/env python3
"""Fail-closed Cargo package-scope checker.

The command intentionally has no authority to select a CI tier.  It reports
whether a committed range is attributable to one Cargo package; callers may
use it as an additional contract, but must retain the repository's existing
required-test selection.  Package identity comes from ``cargo metadata`` for
both ends of the committed range, never from a guessed directory convention.
"""

from __future__ import annotations

import argparse
import ast
from collections import Counter
import io
import json
import os
from pathlib import Path, PurePosixPath
import re
import subprocess
import sys
import tarfile
import tempfile
from typing import Any, Iterable


POLICY_SCHEMA = "oasis7-cargo-package-scope-policy/v1"
AUXILIARY_REGISTRY_PATH = ".pm/cargo-package-auxiliary-files.json"
AUXILIARY_REGISTRY_SCHEMA = "oasis7-cargo-package-auxiliary-files/v1"

AUXILIARY_FORBIDDEN_PREFIXES = (
    ".agents/",
    ".buildkite/",
    ".circleci/",
    ".codex/",
    ".github/",
    ".gitlab/",
    ".pm/",
    ".cargo/",
    "scripts/pm/",
)
AUXILIARY_FORBIDDEN_PATHS = {
    "Jenkinsfile",
    "azure-pipelines.yml",
    "doc/engineering/workflow/source-of-truth.md",
    "scripts/ci-tests.sh",
    "scripts/ci-required-scope.v2.json",
    "scripts/plan-rust-required-scope.json",
    "scripts/plan-rust-required-scope.py",
    "scripts/plan-rust-required-scope.sh",
    "scripts/prepare-task-pr.sh",
    ".gitlab-ci.yml",
    ".travis.yml",
}


class ScopeError(Exception):
    def __init__(self, reason: str, detail: str = "") -> None:
        super().__init__(detail or reason)
        self.reason = reason
        self.detail = detail


def git(repo: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        ["git", "-C", str(repo), *args],
        check=False,
        text=True,
        capture_output=True,
    )
    if check and result.returncode != 0:
        raise ScopeError("git_range_unavailable", result.stderr.strip() or "git command failed")
    return result


def git_blob(repo: Path, revision: str, path: str) -> bytes | None:
    result = subprocess.run(
        ["git", "-C", str(repo), "show", f"{revision}:{path}"],
        check=False,
        capture_output=True,
    )
    if result.returncode != 0:
        return None
    return result.stdout


def changed_files(repo: Path, base: str, head: str) -> tuple[list[str], list[str]]:
    result = git(repo, "diff", "--name-status", "--find-renames", "--find-copies", base, head)
    paths: list[str] = []
    rename_endpoints: list[str] = []
    for line in result.stdout.splitlines():
        fields = line.split("\t")
        if not fields:
            continue
        status = fields[0]
        if status.startswith(("R", "C")) and len(fields) >= 3:
            old_path, new_path = fields[-2], fields[-1]
            paths.extend((old_path, new_path))
            if status.startswith("R"):
                rename_endpoints.extend((old_path, new_path))
        elif len(fields) >= 2:
            paths.append(fields[-1])
    return paths, rename_endpoints


def tracked_paths(repo: Path, revision: str) -> list[str]:
    return [safe_relative(path) for path in git(repo, "ls-tree", "-r", "--name-only", "-z", revision).stdout.split("\0") if path]


def safe_relative(path: str) -> str:
    value = path.replace("\\", "/")
    pure = PurePosixPath(value)
    if pure.is_absolute() or ".." in pure.parts:
        raise ScopeError("invalid_repository_path", f"path escapes repository: {path}")
    return str(pure)


def json_object_without_duplicate_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON object key: {key}")
        result[key] = value
    return result


def parse_auxiliary_registry(
    payload: dict[str, Any], policy_path: str, protected_paths: list[str]
) -> dict[str, str]:
    if (
        not isinstance(payload, dict)
        or set(payload) != {"schema", "auxiliary_files"}
        or payload.get("schema") != AUXILIARY_REGISTRY_SCHEMA
    ):
        raise ScopeError("trusted_policy_invalid", "unexpected auxiliary registry schema or fields")
    entries = payload.get("auxiliary_files")
    if not isinstance(entries, list):
        raise ScopeError("trusted_policy_invalid", "auxiliary_files must be a list")

    protected = {safe_relative(path) for path in protected_paths}
    registry: dict[str, str] = {}
    for entry in entries:
        if not isinstance(entry, dict) or set(entry) != {"path", "package"}:
            raise ScopeError(
                "trusted_policy_invalid",
                "each auxiliary_files entry must contain exactly path and package",
            )
        path = entry.get("path")
        package = entry.get("package")
        if not isinstance(path, str) or not path or "\\" in path or "\x00" in path:
            raise ScopeError("trusted_policy_invalid", "auxiliary path must be a normalized repository-relative file")
        pure = PurePosixPath(path)
        if (
            pure.is_absolute()
            or not pure.parts
            or str(pure) != path
            or any(part in ("", ".", "..") for part in path.split("/"))
            or any(marker in path for marker in ("*", "?", "[", "]"))
        ):
            raise ScopeError("trusted_policy_invalid", f"auxiliary path is not an exact normalized file path: {path}")
        if pure.suffix == ".rs":
            raise ScopeError("ambiguous_package_attribution", f"Rust source cannot be attributed as auxiliary: {path}")
        if pure.name in {"Cargo.toml", "Cargo.lock"}:
            raise ScopeError("ambiguous_package_attribution", f"Cargo manifest or lock cannot be attributed as auxiliary: {path}")
        if path in registry:
            raise ScopeError("trusted_policy_invalid", f"duplicate auxiliary path registration: {path}")
        if (
            path == policy_path
            or path in protected
            or path in AUXILIARY_FORBIDDEN_PATHS
            or any(path.startswith(prefix) for prefix in AUXILIARY_FORBIDDEN_PREFIXES)
        ):
            raise ScopeError("trusted_policy_invalid", f"protected governance path cannot be auxiliary: {path}")
        if not isinstance(package, str) or not package or package != package.strip():
            raise ScopeError("trusted_policy_invalid", f"auxiliary package must be a non-empty exact name: {path}")
        registry[path] = package
    return registry


def trusted_auxiliary_registry(
    repo: Path,
    base: str,
    head: str,
    policy_path: str,
    protected_paths: list[str],
    *,
    registry_maintenance: bool = False,
) -> tuple[dict[str, str], tuple[dict[str, str], dict[str, str]] | None]:
    base_bytes = git_blob(repo, base, AUXILIARY_REGISTRY_PATH)
    head_bytes = git_blob(repo, head, AUXILIARY_REGISTRY_PATH)

    def parse_snapshot(raw: bytes | None, label: str) -> dict[str, str]:
        if raw is None:
            return {}
        try:
            payload = json.loads(
                raw.decode("utf-8"), object_pairs_hook=json_object_without_duplicate_keys
            )
        except (UnicodeDecodeError, ValueError) as exc:
            raise ScopeError(
                "trusted_policy_invalid",
                f"{label} auxiliary registry is not valid JSON: {AUXILIARY_REGISTRY_PATH}",
            ) from exc
        return parse_auxiliary_registry(payload, policy_path, protected_paths)

    if registry_maintenance:
        base_registry = parse_snapshot(base_bytes, "trusted")
        candidate_registry = parse_snapshot(head_bytes, "candidate")
        # A maintenance diff has no business-path changes to attribute.  Keep
        # candidate registrations out of ordinary path ownership regardless.
        return {}, (base_registry, candidate_registry)

    if base_bytes != head_bytes:
        raise ScopeError(
            "policy_self_modification",
            f"auxiliary registry differs from trusted base: {AUXILIARY_REGISTRY_PATH}",
        )
    return parse_snapshot(base_bytes, "trusted"), None


def resolve_relative(source: str, target: str) -> str | None:
    try:
        target_path = PurePosixPath(target)
        if target_path.is_absolute() or re.match(r"^[A-Za-z]:", target):
            return None
        value = PurePosixPath(source).parent.joinpath(target_path)
    except Exception:
        return None
    parts: list[str] = []
    for part in value.parts:
        if part in ("", "."):
            continue
        if part == "..":
            if not parts:
                return None
            parts.pop()
        else:
            parts.append(part)
    return "/".join(parts)


def resolve_manifest_relative(
    root: Path,
    packages: dict[str, list[tuple[str, str]]],
    owner: str | None,
    suffix: str,
) -> str | None:
    """Resolve the supported CARGO_MANIFEST_DIR concatenation for one owner."""
    if owner is None:
        return None
    manifest = package_manifest_paths(packages).get(owner)
    if manifest is None:
        return None
    try:
        checkout = root.resolve()
        manifest_dir = (root / PurePosixPath(manifest).parent).resolve()
        target = Path(f"{manifest_dir}{suffix}").resolve()
        return target.relative_to(checkout).as_posix()
    except (OSError, RuntimeError, ValueError):
        return None


def parse_policy(
    repo: Path,
    base: str,
    head: str,
    policy_arg: str,
    *,
    registry_maintenance: bool = False,
) -> tuple[
    str,
    dict[str, Any],
    dict[str, str],
    tuple[dict[str, str], dict[str, str]] | None,
]:
    policy_path = Path(policy_arg)
    if not policy_path.is_absolute():
        policy_path = repo / policy_path
    try:
        relative = policy_path.resolve().relative_to(repo.resolve()).as_posix()
    except ValueError as exc:
        raise ScopeError("trusted_policy_unavailable", "policy must be inside repository") from exc
    base_bytes = git_blob(repo, base, relative)
    if base_bytes is None:
        raise ScopeError("trusted_policy_unavailable", f"policy is absent from trusted base: {relative}")
    try:
        trusted = json.loads(
            base_bytes.decode("utf-8"), object_pairs_hook=json_object_without_duplicate_keys
        )
    except (UnicodeDecodeError, ValueError) as exc:
        raise ScopeError("trusted_policy_invalid", f"trusted policy is not valid JSON: {relative}") from exc
    current_bytes = policy_path.read_bytes() if policy_path.is_file() else None
    if current_bytes is None or current_bytes != base_bytes:
        raise ScopeError("policy_self_modification", f"policy differs from trusted base: {relative}")
    if not isinstance(trusted, dict) or trusted.get("schema") != POLICY_SCHEMA:
        raise ScopeError("trusted_policy_invalid", "unexpected policy schema")
    if trusted.get("policy_version") != 1:
        raise ScopeError("trusted_policy_invalid", "unsupported policy version")
    if "auxiliary_files" in trusted:
        raise ScopeError("trusted_policy_invalid", "auxiliary registrations must use the separate registry")
    protected = trusted.get("protected_paths")
    if not isinstance(protected, list) or not all(isinstance(item, str) for item in protected):
        raise ScopeError("trusted_policy_invalid", "protected_paths must be a string list")
    auxiliary_registry, maintenance_registries = trusted_auxiliary_registry(
        repo,
        base,
        head,
        relative,
        protected,
        registry_maintenance=registry_maintenance,
    )
    return relative, trusted, auxiliary_registry, maintenance_registries


def extract_git_tree(repo: Path, revision: str, target: Path) -> None:
    result = subprocess.run(
        ["git", "-C", str(repo), "archive", "--format=tar", revision],
        check=False,
        capture_output=True,
    )
    if result.returncode != 0:
        raise ScopeError("git_range_unavailable", result.stderr.decode(errors="replace"))
    target.mkdir(parents=True, exist_ok=True)
    try:
        archive = tarfile.open(fileobj=io.BytesIO(result.stdout), mode="r:")
        for member in archive.getmembers():
            member_path = PurePosixPath(member.name)
            if member_path.is_absolute() or ".." in member_path.parts:
                raise ScopeError("git_range_unavailable", "unsafe path in git archive")
        archive.extractall(target)
    finally:
        archive.close()


def cargo_metadata(root: Path, *, locked: bool = False) -> dict[str, Any]:
    command = ["cargo", "metadata"]
    command.append("--locked" if locked else "--no-deps")
    command.extend(
        ["--format-version", "1", "--manifest-path", str(root / "Cargo.toml")]
    )
    result = subprocess.run(
        command,
        cwd=root,
        check=False,
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        raise ScopeError("cargo_metadata_unavailable", result.stderr.strip() or "cargo metadata failed")
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise ScopeError("cargo_metadata_unavailable", "cargo metadata returned invalid JSON") from exc
    if not isinstance(payload, dict) or not isinstance(payload.get("packages"), list):
        raise ScopeError("cargo_metadata_unavailable", "cargo metadata omitted packages")
    return payload


def package_roots(root: Path, metadata: dict[str, Any]) -> dict[str, list[tuple[str, str]]]:
    packages: dict[str, list[tuple[str, str]]] = {}
    for package in metadata["packages"]:
        if not isinstance(package, dict) or not isinstance(package.get("name"), str):
            raise ScopeError("cargo_metadata_unavailable", "cargo metadata package is malformed")
        name = package["name"]
        manifest = Path(str(package.get("manifest_path", ""))).resolve()
        try:
            manifest_rel = manifest.relative_to(root.resolve()).as_posix()
        except ValueError as exc:
            raise ScopeError("cargo_metadata_unavailable", f"package manifest is outside checkout: {name}") from exc
        roots = {(str(Path(manifest_rel).parent).replace("\\", "/"), manifest_rel)}
        for target in package.get("targets", []):
            if not isinstance(target, dict) or not target.get("src_path"):
                continue
            source = Path(str(target["src_path"])).resolve()
            try:
                source_rel = source.relative_to(root.resolve()).as_posix()
            except ValueError:
                continue
            roots.add((str(Path(source_rel).parent).replace("\\", "/"), source_rel))
        packages[name] = sorted(roots)
    return packages


def owner_for(path: str, packages: dict[str, list[tuple[str, str]]]) -> str | None:
    candidate = PurePosixPath(path)
    owners: list[tuple[int, str]] = []
    for name, roots in packages.items():
        for package_root, target in roots:
            if path == target or candidate == PurePosixPath(package_root) or str(candidate).startswith(package_root + "/"):
                owners.append((len(package_root), name))
    if not owners:
        return None
    owners.sort(reverse=True)
    if len({name for _, name in owners if _ == owners[0][0]}) > 1:
        return None
    return owners[0][1]


def validate_auxiliary_owners(
    registry: dict[str, str],
    base_metadata: dict[str, Any],
    head_metadata: dict[str, Any],
    base_packages: dict[str, list[tuple[str, str]]],
    head_packages: dict[str, list[tuple[str, str]]],
) -> None:
    for path, package in registry.items():
        if metadata_package(base_metadata, package) is None or metadata_package(head_metadata, package) is None:
            raise ScopeError(
                "trusted_policy_invalid",
                f"auxiliary package must resolve uniquely in base and head metadata: {package}",
            )
        if owner_for(path, base_packages) is not None or owner_for(path, head_packages) is not None:
            raise ScopeError(
                "trusted_policy_invalid",
                f"auxiliary path overlaps Cargo metadata ownership: {path}",
            )


def package_manifest_paths(packages: dict[str, list[tuple[str, str]]]) -> dict[str, str]:
    return {
        name: next(target for root, target in roots if target.endswith("Cargo.toml"))
        for name, roots in packages.items()
        if any(target.endswith("Cargo.toml") for _, target in roots)
    }


def build_script_paths(root: Path, metadata: dict[str, Any]) -> dict[str, set[str]]:
    """Use Cargo's active custom-build targets, including manifest-selected paths."""
    scripts: dict[str, set[str]] = {}
    for package in metadata["packages"]:
        name = package.get("name")
        if not isinstance(name, str):
            raise ScopeError("cargo_metadata_unavailable", "package name is unavailable")
        manifest = Path(str(package.get("manifest_path", ""))).resolve()
        for target in package.get("targets", []):
            if not isinstance(target, dict) or "custom-build" not in target.get("kind", []):
                continue
            source = Path(str(target.get("src_path", "")))
            try:
                physical = source.resolve(strict=True)
                physical.relative_to(manifest.parent)
                relative = physical.relative_to(root.resolve()).as_posix()
            except (OSError, ValueError) as exc:
                raise ScopeError("cross_package_symlink", f"custom build target leaves package: {name}") from exc
            scripts.setdefault(name, set()).add(relative)
    return scripts


def cross_package_dependency_edges(
    root: Path,
    metadata: dict[str, Any],
    packages: dict[str, list[tuple[str, str]]],
) -> set[tuple[str, str, str]]:
    """Return workspace-to-workspace dependency edges from Cargo metadata.

    Path dependencies are resolved by their manifest location.  A dependency
    whose package name matches another workspace package but has no path is
    retained as a tagged edge as well: registry/git (or otherwise non-path)
    sources must not disguise a cross-package edge.
    """
    edges: set[tuple[str, str, str]] = set()
    package_names = set(packages)
    for package in metadata["packages"]:
        source = package["name"]
        for dependency in package.get("dependencies", []):
            if not isinstance(dependency, dict):
                continue
            dependency_path = dependency.get("path")
            if dependency_path:
                resolved_path = Path(str(dependency_path)).resolve()
                try:
                    dependency_rel = resolved_path.relative_to(root.resolve()).as_posix()
                except ValueError:
                    continue
                target = owner_for(dependency_rel, packages)
                if target is not None and target != source:
                    edges.add((source, target, str(dependency.get("kind") or "normal")))
                continue

            target = dependency.get("name")
            if not isinstance(target, str) or target not in package_names or target == source:
                continue
            raw_source = str(dependency.get("source") or "")
            if raw_source.startswith("registry+"):
                edge_kind = "registry"
            elif raw_source.startswith("git+"):
                edge_kind = "git"
            else:
                edge_kind = "non_path"
            edges.add((source, target, edge_kind))
    return edges


def workspace_members_and_manifest(text: str) -> tuple[set[str], str] | None:
    def array_end(start: int) -> int | None:
        depth = 0
        quote: str | None = None
        escaped = False
        comment = False
        opened = False
        for index in range(start, len(text)):
            char = text[index]
            if comment:
                if char == "\n":
                    comment = False
                continue
            if quote is not None:
                if quote == '"' and escaped:
                    escaped = False
                elif quote == '"' and char == "\\":
                    escaped = True
                elif char == quote:
                    quote = None
                continue
            if char == "#":
                comment = True
            elif char in ("'", '"'):
                if text.startswith(char * 3, index):
                    return None
                quote = char
            elif char == "[":
                opened = True
                depth += 1
            elif char == "]":
                depth -= 1
                if depth < 0:
                    return None
                if opened and depth == 0:
                    return index + 1
        return None

    in_workspace = False
    offset = 0
    skip_until = 0
    assignments: list[tuple[set[str], int, int]] = []
    for line in text.splitlines(keepends=True):
        line_start = offset
        offset += len(line)
        if line_start < skip_until:
            continue
        content = line.split("#", 1)[0].strip()
        if content.startswith("[") and content.endswith("]"):
            in_workspace = content == "[workspace]"
        if not in_workspace:
            continue
        match = re.match(r"^[ \t]*members[ \t]*=[ \t]*", line)
        if not match:
            continue
        value_start = line_start + match.end()
        value_end = array_end(value_start)
        if value_end is None:
            return None
        line_end = text.find("\n", value_end)
        if line_end < 0:
            line_end = len(text)
        tail = text[value_end:line_end].strip()
        if tail and not tail.startswith("#"):
            return None
        try:
            value = ast.literal_eval(text[value_start:value_end])
        except (SyntaxError, ValueError):
            return None
        if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
            return None
        members = [item.replace("\\", "/") for item in value]
        if len(members) != len(set(members)):
            return None
        assignments.append((set(members), value_start, value_end))
        skip_until = value_end

    if len(assignments) != 1:
        return None
    members, value_start, value_end = assignments[0]
    without_members = text[:value_start] + "[]" + text[value_end:]
    return members, without_members


def lock_records(text: str) -> dict[str, list[dict[str, Any]]]:
    records: dict[str, list[dict[str, Any]]] = {}
    current: dict[str, Any] | None = None
    in_package = False
    in_dependencies = False

    def append_current() -> None:
        if current and current.get("name"):
            records.setdefault(current["name"], []).append(current)

    for line in text.splitlines():
        if line.strip() == "[[package]]":
            append_current()
            current = {}
            in_package = True
            in_dependencies = False
            continue
        if line.startswith("[[") or (line.startswith("[") and not line.startswith("[[")):
            append_current()
            current = None
            in_package = False
            in_dependencies = False
            continue
        if in_package and current is not None:
            stripped = line.strip()
            if in_dependencies:
                if stripped == "]":
                    in_dependencies = False
                else:
                    match = re.fullmatch(r'"([^"]+)",?', stripped)
                    if match:
                        current.setdefault("dependencies", []).append(match.group(1))
                continue
            inline_dependencies = re.fullmatch(r"dependencies\s*=\s*\[(.*)\]", stripped)
            if inline_dependencies:
                current["dependencies"] = re.findall(
                    r'"([^"]+)"', inline_dependencies.group(1)
                )
                continue
            if re.match(r"^dependencies\s*=\s*\[$", stripped):
                current["dependencies"] = []
                in_dependencies = True
                continue
            match = re.match(r'^\s*(name|version|source|checksum)\s*=\s*"([^"]*)"', line)
            if match:
                current[match.group(1)] = match.group(2)
    append_current()
    return records


def lock_change_names(repo: Path, base: str, head: str) -> set[str]:
    old = git_blob(repo, base, "Cargo.lock") or b""
    new = git_blob(repo, head, "Cargo.lock") or b""
    before = lock_records(old.decode("utf-8", errors="replace"))
    after = lock_records(new.decode("utf-8", errors="replace"))
    return {name for name in set(before) | set(after) if before.get(name) != after.get(name)}


def lock_workspace_record(repo: Path, revision: str, package: str) -> dict[str, Any] | None:
    blob = git_blob(repo, revision, "Cargo.lock")
    if blob is None:
        return None
    records = lock_records(blob.decode("utf-8", errors="replace"))
    workspace_records = [record for record in records.get(package, []) if "source" not in record]
    if len(workspace_records) != 1:
        return None
    return workspace_records[0]


def lock_dependency_names(repo: Path, revision: str, package: str) -> set[str] | None:
    record = lock_workspace_record(repo, revision, package)
    if record is None:
        return None
    return {
        dependency.split(" ", 1)[0]
        for dependency in record.get("dependencies", [])
    }


def lock_dependency_references_are_canonical(
    repo: Path,
    revision: str,
    package: str,
    metadata: dict[str, Any],
) -> bool:
    blob = git_blob(repo, revision, "Cargo.lock")
    if blob is None:
        return False
    records = lock_records(blob.decode("utf-8", errors="replace"))
    workspace_records = [record for record in records.get(package, []) if "source" not in record]
    if len(workspace_records) != 1:
        return False
    dependencies = workspace_records[0].get("dependencies", [])
    if not isinstance(dependencies, list) or not all(isinstance(item, str) for item in dependencies):
        return False
    if len(dependencies) != len(set(dependencies)):
        return False

    package_metadata = metadata_package(metadata, package)
    metadata_dependencies = package_metadata.get("dependencies") if package_metadata else None
    if not isinstance(metadata_dependencies, list):
        return False
    metadata_name_counts: dict[str, int] = {}
    for dependency in metadata_dependencies:
        if not isinstance(dependency, dict) or not isinstance(dependency.get("name"), str):
            return False
        name = dependency["name"]
        metadata_name_counts[name] = metadata_name_counts.get(name, 0) + 1

    canonical_names: dict[str, str] = {}
    for name, candidates in records.items():
        if not candidates:
            continue
        identities: set[tuple[str, str | None]] = set()
        for candidate in candidates:
            version = candidate.get("version")
            source = candidate.get("source")
            if not isinstance(version, str) or not version:
                return False
            if source is not None and (not isinstance(source, str) or not source):
                return False
            identity = (version, source)
            if identity in identities:
                return False
            identities.add(identity)

        for candidate in candidates:
            version = candidate["version"]
            if len(candidates) == 1:
                reference = name
            else:
                reference = f"{name} {version}"
                same_version = [item for item in candidates if item["version"] == version]
                if len(same_version) > 1:
                    source = candidate.get("source")
                    if source is not None:
                        reference += f" ({source})"
                    elif sum(item.get("source") is None for item in same_version) != 1:
                        return False
            if reference in canonical_names:
                return False
            canonical_names[reference] = name

    actual_name_counts: dict[str, int] = {}
    for dependency in dependencies:
        name = canonical_names.get(dependency)
        if name is None:
            return False
        actual_name_counts[name] = actual_name_counts.get(name, 0) + 1
        if actual_name_counts[name] > metadata_name_counts.get(name, 0):
            return False
    return True


def metadata_package(metadata: dict[str, Any], package: str) -> dict[str, Any] | None:
    matches = [
        item
        for item in metadata.get("packages", [])
        if isinstance(item, dict) and item.get("name") == package
    ]
    if len(matches) != 1:
        return None
    return matches[0]


def metadata_dependency_names(metadata: dict[str, Any], package: str) -> set[str] | None:
    match = metadata_package(metadata, package)
    if match is None:
        return None
    dependencies = match.get("dependencies", [])
    if not isinstance(dependencies, list):
        return None
    names = {
        dependency.get("name")
        for dependency in dependencies
        if isinstance(dependency, dict) and isinstance(dependency.get("name"), str)
    }
    return names


def lock_diff_has_unattributable_lines(
    repo: Path, base: str, head: str, path: str = "Cargo.lock"
) -> bool:
    def is_mechanical_lock(text: str) -> bool:
        in_dependencies = False
        for line in text.splitlines():
            content = line.strip()
            if not content:
                continue
            if content in {
                "# This file is automatically @generated by Cargo.",
                "# It is not intended for manual editing.",
            }:
                continue
            if content == "[[package]]":
                in_dependencies = False
                continue
            if in_dependencies:
                if content == "]":
                    in_dependencies = False
                    continue
                if re.fullmatch(r'"[^"]+",?', content):
                    continue
                return False
            if content in {"dependencies = [", "dependencies = []"}:
                in_dependencies = content.endswith("[")
                continue
            if re.fullmatch(r'dependencies\s*=\s*\[(?:\s*"[^"]+",?\s*)*\]', content):
                continue
            if re.fullmatch(r"version\s*=\s*\d+", content):
                continue
            if re.fullmatch(r'(name|version|source|checksum)\s*=\s*"[^"]*"', content):
                continue
            return False
        return not in_dependencies

    for revision in (base, head):
        lock_blob = git_blob(repo, revision, path)
        if lock_blob is None or not is_mechanical_lock(lock_blob.decode("utf-8", errors="replace")):
            return True
    return False


def standalone_workspace_metadata(root: Path, manifest_path: str) -> dict[str, Any] | None:
    """Return locked, resolved metadata for a standalone workspace in a Git snapshot."""
    workspace = root / PurePosixPath(manifest_path).parent
    try:
        metadata = cargo_metadata(workspace, locked=True)
    except ScopeError:
        return None
    try:
        workspace_root = Path(str(metadata.get("workspace_root", ""))).resolve()
        workspace_rel = workspace_root.relative_to(root.resolve()).as_posix()
    except (OSError, ValueError):
        return None

    raw_packages = metadata.get("packages")
    workspace_members = metadata.get("workspace_members")
    resolve = metadata.get("resolve")
    if (
        not isinstance(raw_packages, list)
        or not isinstance(workspace_members, list)
        or not workspace_members
        or not all(isinstance(item, str) and item for item in workspace_members)
        or len(workspace_members) != len(set(workspace_members))
        or not isinstance(resolve, dict)
        or not isinstance(resolve.get("nodes"), list)
    ):
        return None

    package_by_id: dict[str, dict[str, Any]] = {}
    identities_by_id: dict[str, tuple[str, str, str | None]] = {}
    seen_identities: set[tuple[str, str, str | None]] = set()
    for package in raw_packages:
        if not isinstance(package, dict):
            return None
        package_id = package.get("id")
        name, version, source = (
            package.get("name"),
            package.get("version"),
            package.get("source"),
        )
        if (
            not isinstance(package_id, str)
            or not package_id
            or not isinstance(name, str)
            or not name
            or not isinstance(version, str)
            or not version
            or (source is not None and (not isinstance(source, str) or not source))
            or package_id in package_by_id
        ):
            return None
        identity = (name, version, source)
        # A Cargo.lock reference cannot distinguish two package IDs with the
        # same name/version/source, so ambiguous metadata must fail closed.
        if identity in seen_identities:
            return None
        seen_identities.add(identity)
        package_by_id[package_id] = package
        identities_by_id[package_id] = identity

    packages: list[dict[str, Any]] = []
    member_paths: set[str] = set()
    for package_id in workspace_members:
        package = package_by_id.get(package_id)
        if package is None:
            return None
        try:
            package_manifest = Path(str(package.get("manifest_path", ""))).resolve()
            package_manifest_rel = package_manifest.relative_to(root.resolve()).as_posix()
        except (OSError, ValueError):
            return None
        if package_manifest_rel in member_paths:
            return None
        member_paths.add(package_manifest_rel)
        raw_dependencies = package.get("dependencies")
        if not isinstance(raw_dependencies, list):
            return None
        dependencies: list[tuple[str, str | None, str | None]] = []
        for dependency in raw_dependencies:
            if (
                not isinstance(dependency, dict)
                or not isinstance(dependency.get("name"), str)
                or not dependency["name"]
            ):
                return None
            dependency_path = dependency.get("path")
            dependency_rel: str | None = None
            if dependency_path is not None:
                if not isinstance(dependency_path, str):
                    return None
                try:
                    dependency_rel = Path(str(dependency_path)).resolve().relative_to(root.resolve()).as_posix()
                except (OSError, ValueError):
                    return None
            kind = dependency.get("kind")
            if kind is not None and not isinstance(kind, str):
                return None
            dependencies.append((dependency["name"], kind, dependency_rel))
        packages.append({
            "id": package_id,
            "name": package["name"],
            "manifest_path": package_manifest_rel,
            "dependencies": sorted(dependencies, key=lambda item: (item[0], item[1] or "", item[2] or "")),
        })

    resolved_edges: dict[str, list[str]] = {}
    for node in resolve["nodes"]:
        if not isinstance(node, dict):
            return None
        package_id = node.get("id")
        dependencies = node.get("deps")
        if (
            not isinstance(package_id, str)
            or package_id not in package_by_id
            or package_id in resolved_edges
            or not isinstance(dependencies, list)
        ):
            return None
        dependency_ids: set[str] = set()
        for dependency in dependencies:
            if not isinstance(dependency, dict):
                return None
            dependency_id = dependency.get("pkg")
            dependency_name = dependency.get("name")
            dependency_kinds = dependency.get("dep_kinds")
            if (
                not isinstance(dependency_id, str)
                or dependency_id not in package_by_id
                or not isinstance(dependency_name, str)
                or not dependency_name
                or not isinstance(dependency_kinds, list)
            ):
                return None
            for kind in dependency_kinds:
                if (
                    not isinstance(kind, dict)
                    or kind.get("kind") not in (None, "normal", "build", "dev")
                    or (kind.get("target") is not None and not isinstance(kind.get("target"), str))
                ):
                    return None
            dependency_ids.add(dependency_id)
        resolved_edges[package_id] = sorted(dependency_ids)

    if any(package_id not in resolved_edges for package_id in workspace_members):
        return None
    return {
        "workspace_root": workspace_rel,
        "packages": packages,
        "resolved_identities": identities_by_id,
        "resolved_edges": resolved_edges,
    }


def lock_record_index(
    records: dict[str, list[dict[str, Any]]],
) -> dict[tuple[str, str, str | None], dict[str, Any]] | None:
    indexed: dict[tuple[str, str, str | None], dict[str, Any]] = {}
    for name, package_records in records.items():
        for record in package_records:
            version, source = record.get("version"), record.get("source")
            if not isinstance(version, str) or not version:
                return None
            if source is not None and (not isinstance(source, str) or not source):
                return None
            key = (name, version, source)
            if key in indexed:
                return None
            dependencies = record.get("dependencies", [])
            if not isinstance(dependencies, list) or not all(isinstance(item, str) for item in dependencies):
                return None
            if len(dependencies) != len(set(dependencies)):
                return None
            indexed[key] = record
    return indexed


def lock_reference_index(
    records: dict[str, list[dict[str, Any]]],
) -> dict[str, tuple[str, str, str | None]] | None:
    references: dict[str, tuple[str, str, str | None]] = {}
    for name, package_records in records.items():
        for record in package_records:
            version, source = record.get("version"), record.get("source")
            if not isinstance(version, str) or not version:
                return None
            if source is not None and (not isinstance(source, str) or not source):
                return None
            if len(package_records) == 1:
                reference = name
            else:
                reference = f"{name} {version}"
                same_version = [item for item in package_records if item.get("version") == version]
                if len(same_version) > 1:
                    if source is None:
                        if sum(item.get("source") is None for item in same_version) != 1:
                            return None
                    else:
                        reference += f" ({source})"
            key = (name, version, source)
            if reference in references:
                return None
            references[reference] = key
    return references


def lock_closure_matches_metadata(
    records: dict[tuple[str, str, str | None], dict[str, Any]],
    references: dict[str, tuple[str, str, str | None]],
    metadata: dict[str, Any],
    root_identity: tuple[str, str, str | None],
) -> set[tuple[str, str, str | None]] | None:
    """Prove lock identities and outgoing edges for one resolved package closure."""
    identities = metadata.get("resolved_identities")
    resolved_edges = metadata.get("resolved_edges")
    if not isinstance(identities, dict) or not isinstance(resolved_edges, dict):
        return None

    identity_to_id: dict[tuple[str, str, str | None], str] = {}
    for package_id, identity in identities.items():
        if (
            not isinstance(package_id, str)
            or not package_id
            or not isinstance(identity, tuple)
            or len(identity) != 3
            or not isinstance(identity[0], str)
            or not isinstance(identity[1], str)
            or (identity[2] is not None and not isinstance(identity[2], str))
            or identity in identity_to_id
        ):
            return None
        identity_to_id[identity] = package_id

    if root_identity not in identity_to_id:
        return None
    reachable: set[tuple[str, str, str | None]] = set()
    pending = [root_identity]
    while pending:
        identity = pending.pop()
        if identity in reachable:
            continue
        record = records.get(identity)
        package_id = identity_to_id.get(identity)
        dependency_ids = resolved_edges.get(package_id) if package_id is not None else None
        if (
            record is None
            or not isinstance(dependency_ids, list)
            or not all(isinstance(item, str) for item in dependency_ids)
        ):
            return None

        expected_dependencies: set[tuple[str, str, str | None]] = set()
        for dependency_id in dependency_ids:
            dependency_identity = identities.get(dependency_id)
            if (
                not isinstance(dependency_identity, tuple)
                or len(dependency_identity) != 3
                or not isinstance(dependency_identity[0], str)
                or not isinstance(dependency_identity[1], str)
                or (dependency_identity[2] is not None and not isinstance(dependency_identity[2], str))
                or dependency_identity not in records
            ):
                return None
            expected_dependencies.add(dependency_identity)

        lock_dependencies = record.get("dependencies", [])
        if not isinstance(lock_dependencies, list) or not all(
            isinstance(item, str) for item in lock_dependencies
        ):
            return None
        actual_dependencies: set[tuple[str, str, str | None]] = set()
        for reference in lock_dependencies:
            dependency_identity = references.get(reference)
            if dependency_identity is None:
                return None
            actual_dependencies.add(dependency_identity)
        if actual_dependencies != expected_dependencies:
            return None

        reachable.add(identity)
        pending.extend(expected_dependencies)
    return reachable


def standalone_lock_is_mechanical(
    repo: Path,
    base: str,
    head: str,
    base_root_metadata: dict[str, Any],
    head_root_metadata: dict[str, Any],
    base_packages: dict[str, list[tuple[str, str]]],
    head_packages: dict[str, list[tuple[str, str]]],
    standalone_metadata: tuple[dict[str, Any], dict[str, Any]] | None,
    path: str,
    primary: str,
    added_edges: set[tuple[str, str, str]],
) -> bool:
    """Prove a separate lock changed only through one admitted package edge."""
    if not path.endswith("/Cargo.lock") or standalone_metadata is None:
        return False
    manifest_path = path[: -len("Cargo.lock")] + "Cargo.toml"
    old_manifest, new_manifest = git_blob(repo, base, manifest_path), git_blob(repo, head, manifest_path)
    if old_manifest is None or old_manifest != new_manifest:
        return False

    base_standalone, head_standalone = standalone_metadata
    workspace_path = str(PurePosixPath(manifest_path).parent)
    if (
        base_standalone.get("workspace_root") != workspace_path
        or head_standalone.get("workspace_root") != workspace_path
    ):
        return False
    if manifest_path in package_manifest_paths(base_packages).values() or manifest_path in package_manifest_paths(head_packages).values():
        return False
    if not isinstance(base_standalone.get("packages"), list) or not isinstance(head_standalone.get("packages"), list):
        return False
    base_members = {item.get("manifest_path"): item for item in base_standalone["packages"]}
    head_members = {item.get("manifest_path"): item for item in head_standalone["packages"]}
    if not base_members or len(base_members) != len(base_standalone["packages"]):
        return False
    if set(base_members) != set(head_members) or len(head_members) != len(head_standalone["packages"]):
        return False
    base_manifest = package_manifest_paths(base_packages).get(primary)
    head_manifest = package_manifest_paths(head_packages).get(primary)
    if base_manifest is None or head_manifest is None:
        return False
    base_target_path = str(PurePosixPath(base_manifest).parent)
    head_target_path = str(PurePosixPath(head_manifest).parent)
    consumers = 0
    for consumer_manifest, base_consumer in base_members.items():
        head_consumer = head_members[consumer_manifest]
        if base_consumer.get("name") != head_consumer.get("name"):
            return False
        base_dependencies = base_consumer.get("dependencies")
        head_dependencies = head_consumer.get("dependencies")
        if not isinstance(base_dependencies, list) or base_dependencies != head_dependencies:
            return False
        if git_blob(repo, base, consumer_manifest) != git_blob(repo, head, consumer_manifest):
            return False
        if (primary, None, base_target_path) in base_dependencies and (
            primary, None, head_target_path
        ) in head_dependencies:
            consumers += 1
    if consumers == 0:
        return False

    admitted = [edge for edge in added_edges if edge[0] == primary and edge[2] == "normal"]
    if len(admitted) != 1 or len(admitted) != len(added_edges):
        return False
    target = admitted[0][1]
    old_blob, new_blob = git_blob(repo, base, path), git_blob(repo, head, path)
    if old_blob is None or new_blob is None:
        return False
    old_text, new_text = old_blob.decode("utf-8", errors="replace"), new_blob.decode("utf-8", errors="replace")
    if lock_diff_has_unattributable_lines(repo, base, head, path):
        return False
    old_header, _, old_packages_text = old_text.partition("[[package]]")
    new_header, _, new_packages_text = new_text.partition("[[package]]")
    if old_header != new_header or not re.fullmatch(r"(?:[^\S\n]*#.*\n|\s)*version\s*=\s*\d+\s*\n?", old_header):
        return False
    if not old_packages_text or not new_packages_text:
        return False

    old_records = lock_records(old_text)
    new_records = lock_records(new_text)
    old_index, new_index = lock_record_index(old_records), lock_record_index(new_records)
    old_references, new_references = lock_reference_index(old_records), lock_reference_index(new_records)
    if old_index is None or new_index is None or old_references is None or new_references is None:
        return False
    if not set(old_index).issubset(new_index):
        return False
    primary_base = [key for key in old_index if key[0] == primary and key[2] is None]
    primary_head = [key for key in new_index if key[0] == primary and key[2] is None]
    if len(primary_base) != 1 or len(primary_head) != 1 or primary_base[0] != primary_head[0]:
        return False
    primary_key = primary_base[0]
    base_primary_metadata = metadata_package(base_root_metadata, primary)
    head_primary_metadata = metadata_package(head_root_metadata, primary)
    if (
        base_primary_metadata is None
        or head_primary_metadata is None
        or primary_key != (
            primary,
            base_primary_metadata.get("version"),
            base_primary_metadata.get("source"),
        )
        or primary_key != (
            primary,
            head_primary_metadata.get("version"),
            head_primary_metadata.get("source"),
        )
    ):
        return False
    old_primary, new_primary = old_index[primary_key], new_index[primary_key]
    if {key: value for key, value in old_primary.items() if key != "dependencies"} != {
        key: value for key, value in new_primary.items() if key != "dependencies"
    }:
        return False
    if any(old_index[key] != new_index[key] for key in old_index if key != primary_key):
        return False

    old_dependencies = old_primary.get("dependencies", [])
    new_dependencies = new_primary.get("dependencies", [])
    if not isinstance(old_dependencies, list) or not isinstance(new_dependencies, list):
        return False
    try:
        old_keys = Counter(old_references[item] for item in old_dependencies)
        new_keys = Counter(new_references[item] for item in new_dependencies)
    except KeyError:
        return False
    target_metadata = metadata_package(head_root_metadata, target)
    if target_metadata is None or not isinstance(target_metadata.get("version"), str):
        return False
    target_key = (target, target_metadata["version"], target_metadata.get("source"))
    if target_key not in new_index or new_keys - old_keys != Counter({target_key: 1}) or old_keys - new_keys:
        return False

    added_records = set(new_index) - set(old_index)
    by_target_name = [key for key in new_index if key[0] == target]
    if len(by_target_name) != 1 or by_target_name[0] != target_key:
        return False
    target_dependencies = new_index[target_key].get("dependencies", [])
    expected_target_dependencies = metadata_dependency_names(head_root_metadata, target)
    if not isinstance(target_dependencies, list) or expected_target_dependencies is None:
        return False
    try:
        actual_target_dependencies = {new_references[item][0] for item in target_dependencies}
    except KeyError:
        return False
    if actual_target_dependencies != expected_target_dependencies:
        return False

    base_reachable = lock_closure_matches_metadata(
        old_index, old_references, base_standalone, primary_key
    )
    head_reachable = lock_closure_matches_metadata(
        new_index, new_references, head_standalone, primary_key
    )
    target_reachable = lock_closure_matches_metadata(
        new_index, new_references, head_standalone, target_key
    )
    if base_reachable is None or head_reachable is None or target_reachable is None:
        return False
    return added_records.issubset(target_reachable)


def root_manifest_is_mechanical(repo: Path, base: str, head: str, new_manifest_paths: set[str]) -> bool:
    old_blob = git_blob(repo, base, "Cargo.toml")
    new_blob = git_blob(repo, head, "Cargo.toml")
    if old_blob is None or new_blob is None:
        return False
    old_parsed = workspace_members_and_manifest(old_blob.decode("utf-8", errors="replace"))
    new_parsed = workspace_members_and_manifest(new_blob.decode("utf-8", errors="replace"))
    if old_parsed is None or new_parsed is None:
        return False
    old_members, old_manifest = old_parsed
    new_members, new_manifest = new_parsed
    if not new_members or not new_members.issuperset(old_members):
        return False
    added = new_members - old_members
    if added != new_manifest_paths:
        return False
    return old_manifest == new_manifest


def source_text(repo: Path, head: str, path: str) -> str:
    blob = git_blob(repo, head, path)
    if blob is None:
        return ""
    return blob.decode("utf-8", errors="replace")


def without_rust_comments(source: str) -> str:
    """Remove nested Rust comments while preserving string literal contents."""
    output: list[str] = []
    index = 0
    while index < len(source):
        if source.startswith("//", index):
            end = source.find("\n", index)
            index = len(source) if end < 0 else end
            output.append(" ")
        elif source.startswith("/*", index):
            depth = 1
            index += 2
            while index < len(source) and depth:
                if source.startswith("/*", index):
                    depth += 1
                    index += 2
                elif source.startswith("*/", index):
                    depth -= 1
                    index += 2
                else:
                    index += 1
            if depth:
                raise ScopeError("unresolved_rust_source_reference", "unterminated Rust block comment")
            output.append(" ")
        elif source[index] == '"':
            start = index
            index += 1
            while index < len(source):
                if source[index] == "\\":
                    index += 2
                elif source[index] == '"':
                    index += 1
                    break
                else:
                    index += 1
            output.append(source[start:index])
        elif source[index] == "r" and (raw := re.match(r'r(#{0,255})"', source[index:])):
            closing = '"' + raw.group(1)
            end = source.find(closing, index + raw.end())
            if end < 0:
                raise ScopeError("unresolved_rust_source_reference", "unterminated Rust raw string")
            output.append(source[index:end + len(closing)])
            index = end + len(closing)
        else:
            output.append(source[index])
            index += 1
    return "".join(output)


def check_cross_package_edges(
    repo: Path,
    head: str,
    paths: Iterable[str],
    packages: dict[str, list[tuple[str, str]]],
    changed: set[str],
    build_scripts: dict[str, set[str]],
    active_build_packages: set[str],
) -> None:
    # Rust paths may use an ordinary or a raw string literal.  Keep the raw
    # delimiter matched to its closing delimiter, including multiple hashes.
    literal = r'(?:"([^"\n]+)"|r(#{0,255})"([^"\n]+)"\2)'
    manifest_relative = re.compile(
        r'concat\s*!\s*\(\s*env\s*!\s*\(\s*"CARGO_MANIFEST_DIR"\s*\)\s*,'
        r'\s*"([^"\\\n]*)"\s*\)'
    )
    affected_packages = {owner_for(path, packages) for path in changed} - {None}
    for path in paths:
        owner = owner_for(path, packages)
        if not path.endswith(".rs"):
            continue
        text = without_rust_comments(source_text(repo, head, path))
        for prefix, terminator, reason, allow_manifest_relative in (
            (r"\binclude\s*!\s*\(\s*", ")", "cross_package_include", True),
            (r"\binclude_bytes\s*!\s*\(\s*", ")", "cross_package_include", True),
            (r"\binclude_str\s*!\s*\(\s*", ")", "cross_package_include", True),
            (r"#\s*\[\s*path\s*=\s*", "]", "cross_package_path", False),
        ):
            for reference in re.finditer(prefix, text):
                expression = text[reference.end():]
                match = re.match(literal, expression)
                is_manifest_relative = False
                if match is not None and expression[match.end():].lstrip().startswith(terminator):
                    target = match.group(1) or match.group(3)
                    if "\\" in target:
                        if affected_packages:
                            raise ScopeError("unresolved_rust_source_reference", f"{path} has escaped {reason}")
                        continue
                    resolved = resolve_relative(path, target)
                else:
                    manifest_match = (
                        manifest_relative.match(expression) if allow_manifest_relative else None
                    )
                    if (
                        manifest_match is None
                        or not expression[manifest_match.end():].lstrip().startswith(terminator)
                    ):
                        if affected_packages:
                            raise ScopeError("unresolved_rust_source_reference", f"{path} has non-literal {reason}")
                        continue
                    is_manifest_relative = True
                    suffix = manifest_match.group(1)
                    if "\\" in suffix:
                        if affected_packages:
                            raise ScopeError("unresolved_rust_source_reference", f"{path} has escaped {reason}")
                        continue
                    if owner is None:
                        if affected_packages:
                            raise ScopeError(
                                "unresolved_rust_source_reference",
                                f"{path} has no unique Cargo owner for manifest-relative {reason}",
                            )
                        continue
                    resolved = resolve_manifest_relative(repo, packages, owner, suffix)
                if resolved is None:
                    if affected_packages:
                        raise ScopeError("unresolved_rust_source_reference", f"{path} has out-of-repository {reason}")
                    continue
                target_owner = owner_for(resolved, packages) if resolved else None
                if is_manifest_relative and target_owner is None:
                    if affected_packages:
                        raise ScopeError(
                            "unresolved_rust_source_reference",
                            f"{path} reaches a target with no unique Cargo owner: {resolved}",
                        )
                    continue
                if target_owner is not None and target_owner != owner and (
                    owner in affected_packages or target_owner in affected_packages
                ):
                    raise ScopeError(reason, f"{path} reaches {resolved}")
        if owner in active_build_packages and path in build_scripts.get(owner, set()):
            def check_output(target: str) -> None:
                # Cargo executes build scripts with the package root as cwd,
                # even when the script itself lives in a nested directory.
                manifest = package_manifest_paths(packages).get(owner)
                resolved = resolve_relative(manifest, target) if manifest else None
                target_owner = owner_for(resolved, packages) if resolved else None
                if target_owner is not None and target_owner != owner:
                    raise ScopeError("cross_package_generated_output", f"{path} writes {resolved}")

            for reference in re.finditer(r"(?:fs::write|File::create|create_dir_all)\s*\(\s*", text):
                match = re.match(literal, text[reference.end():])
                if match is None or (match.group(1) is not None and "\\" in match.group(1)):
                    raise ScopeError("unresolved_generated_output", f"{path} has non-literal output path")
                check_output(match.group(1) or match.group(3))
            for reference in re.finditer(r"fs::(?:copy|rename|hard_link|symlink)\s*\(\s*", text):
                first = re.match(literal, text[reference.end():])
                if first is None:
                    raise ScopeError("unresolved_generated_output", f"{path} has non-literal source path")
                rest = text[reference.end() + first.end():]
                separator = re.match(r"\s*,\s*", rest)
                second = re.match(literal, rest[separator.end():]) if separator else None
                if second is None or (second.group(1) is not None and "\\" in second.group(1)):
                    raise ScopeError("unresolved_generated_output", f"{path} has non-literal output path")
                check_output(second.group(1) or second.group(3))
            # A build script runs arbitrary Rust at build time.  Path-pattern
            # checks above preserve a precise reason for known cross-package
            # writes, but cannot prove the absence of writes through aliases,
            # options, helper functions, or additional filesystem APIs.
            if not re.fullmatch(r"\s*fn\s+main\s*\(\s*\)\s*\{\s*\}\s*", text):
                raise ScopeError("unresolved_generated_output", f"{path} is not a provably inert build script")


def evaluate(args: argparse.Namespace) -> dict[str, Any]:
    repo = Path(args.repo_root).resolve()
    if not repo.is_dir() or not (repo / ".git").exists():
        raise ScopeError("invalid_repository", f"not a git checkout: {repo}")
    paths, renames = changed_files(repo, args.base, args.head)
    normalized_paths = [safe_relative(path) for path in paths]
    registry_maintenance = (
        len(normalized_paths) == 1
        and normalized_paths[0] == AUXILIARY_REGISTRY_PATH
        and not renames
    )
    policy_path, policy, auxiliary_owners, maintenance_registries = parse_policy(
        repo,
        args.base,
        args.head,
        args.policy,
        registry_maintenance=registry_maintenance,
    )
    protected = {safe_relative(path) for path in policy["protected_paths"]}
    standalone_lock_paths = sorted(
        path for path in normalized_paths if path.endswith("/Cargo.lock")
    )
    if len(standalone_lock_paths) > 1:
        raise ScopeError("ambiguous_package_attribution", ", ".join(standalone_lock_paths))
    standalone_metadata: tuple[dict[str, Any], dict[str, Any]] | None = None
    if policy_path in normalized_paths or protected.intersection(normalized_paths):
        raise ScopeError("policy_self_modification", "protected scope policy changed")
    with tempfile.TemporaryDirectory(prefix="cargo-scope-base-") as base_dir, tempfile.TemporaryDirectory(
        prefix="cargo-scope-head-"
    ) as head_dir:
        base_root = Path(base_dir)
        head_root = Path(head_dir)
        extract_git_tree(repo, args.base, base_root)
        extract_git_tree(repo, args.head, head_root)
        base_metadata = cargo_metadata(base_root)
        head_metadata = cargo_metadata(head_root)
        base_packages = package_roots(base_root, base_metadata)
        head_packages = package_roots(head_root, head_metadata)
        registries_to_validate = (
            maintenance_registries if maintenance_registries is not None else (auxiliary_owners,)
        )
        for registry in registries_to_validate:
            validate_auxiliary_owners(
                registry,
                base_metadata,
                head_metadata,
                base_packages,
                head_packages,
            )
        head_build_scripts = build_script_paths(head_root, head_metadata)
        changed = set(normalized_paths)
        package_changed = any(
            owner_for(path, head_packages) or owner_for(path, base_packages)
            for path in changed
        )
        for revision, root, packages in (
            (args.base, base_root, base_packages),
            (args.head, head_root, head_packages),
        ):
            for path in tracked_paths(repo, revision):
                link = root / path
                if not link.is_symlink():
                    continue
                try:
                    physical = link.resolve(strict=True).relative_to(root.resolve()).as_posix()
                except (OSError, ValueError) as exc:
                    if path in changed or (package_changed and owner_for(path, packages)):
                        raise ScopeError("ambiguous_package_attribution", f"unresolved or escaping symlink: {path}") from exc
                    continue
                touches_changed = package_changed or path in changed or physical in changed or (
                    link.is_dir() and any(item.startswith(physical + "/") for item in changed)
                )
                if not touches_changed:
                    continue
                lexical_owner = owner_for(path, packages)
                physical_owner = owner_for(physical, packages)
                if lexical_owner != physical_owner or physical_owner is None:
                    raise ScopeError("cross_package_symlink", f"{path} resolves to {physical}")
        base_dependency_edges = cross_package_dependency_edges(
            base_root, base_metadata, base_packages
        )
        head_dependency_edges = cross_package_dependency_edges(
            head_root, head_metadata, head_packages
        )
        added_dependency_edges = head_dependency_edges - base_dependency_edges
        if standalone_lock_paths:
            lock_path = standalone_lock_paths[0]
            manifest_path = lock_path[: -len("Cargo.lock")] + "Cargo.toml"
            old_manifest = git_blob(repo, args.base, manifest_path)
            new_manifest = git_blob(repo, args.head, manifest_path)
            if old_manifest is not None and old_manifest == new_manifest:
                base_standalone = standalone_workspace_metadata(base_root, manifest_path)
                head_standalone = standalone_workspace_metadata(head_root, manifest_path)
                if base_standalone is not None and head_standalone is not None:
                    standalone_metadata = (base_standalone, head_standalone)
    requested_primary = None if args.primary_package == "auto" else args.primary_package
    if requested_primary is not None and requested_primary not in head_packages:
        raise ScopeError("unknown_primary_package", args.primary_package)

    base_package_names = set(base_packages)
    head_package_names = set(head_packages)
    added_names = head_package_names - base_package_names
    package_owners: set[str] = set()
    unowned_paths: list[str] = []
    unowned_rust: list[str] = []
    for path in normalized_paths:
        if path in ("Cargo.toml", "Cargo.lock") or path == policy_path:
            continue
        owner = owner_for(path, head_packages) or owner_for(path, base_packages)
        if owner is None:
            owner = auxiliary_owners.get(path)
        if owner is not None:
            package_owners.add(owner)
        else:
            unowned_paths.append(path)
            if path.endswith(".rs") or Path(path).name == "Cargo.toml":
                unowned_rust.append(path)
    if unowned_rust:
        raise ScopeError("ambiguous_package_attribution", ", ".join(unowned_rust))

    for old_path, new_path in zip(renames[::2], renames[1::2]):
        old_owner = owner_for(old_path, base_packages) or auxiliary_owners.get(old_path)
        new_owner = owner_for(new_path, head_packages) or auxiliary_owners.get(new_path)
        if old_owner and new_owner and old_owner != new_owner:
            raise ScopeError("cross_package_rename", f"{old_path} -> {new_path}")
        if old_owner:
            package_owners.add(old_owner)
        if new_owner:
            package_owners.add(new_owner)

    if len(package_owners) > 1:
        raise ScopeError("multiple_business_packages", ", ".join(sorted(package_owners)))
    primary_package = requested_primary
    if primary_package is None and package_owners:
        primary_package = next(iter(package_owners))
    if package_owners and package_owners != {primary_package}:
        raise ScopeError("primary_package_mismatch", ", ".join(sorted(package_owners)))
    if added_dependency_edges:
        base_package_names = set(base_packages)
        base_edge_pairs = {(source, target) for source, target, _ in base_dependency_edges}
        invalid_edges: list[tuple[str, str, str]] = []
        for source, target, kind in sorted(added_dependency_edges):
            if kind != "normal":
                invalid_edges.append((source, target, kind))
                continue
            if source not in base_package_names or target not in base_package_names:
                invalid_edges.append((source, target, kind))
                continue
            if package_owners != {source} or target in package_owners:
                invalid_edges.append((source, target, kind))
                continue
            if (source, target) in base_edge_pairs:
                invalid_edges.append((source, target, kind))
                continue
            if any(
                edge_source == target and edge_target == source
                for edge_source, edge_target, _ in head_dependency_edges
            ):
                invalid_edges.append((source, target, kind))
        if invalid_edges:
            detail = ", ".join(
                f"{source} -[{kind}]-> {target}" for source, target, kind in invalid_edges
            )
            raise ScopeError("cross_package_dependency", detail)

    other_unowned_paths = [path for path in unowned_paths if path not in standalone_lock_paths]
    if other_unowned_paths and primary_package is not None:
        raise ScopeError("ambiguous_package_attribution", ", ".join(other_unowned_paths))
    for path in standalone_lock_paths:
        if primary_package is None or not standalone_lock_is_mechanical(
            repo,
            args.base,
            args.head,
            base_metadata,
            head_metadata,
            base_packages,
            head_packages,
            standalone_metadata,
            path,
            primary_package,
            added_dependency_edges,
        ):
            raise ScopeError("unattributable_lock_change", path)

    root_manifest_changed = "Cargo.toml" in normalized_paths
    root_lock_changed = "Cargo.lock" in normalized_paths
    new_manifest_paths = {
        str(Path(package_manifest_paths(head_packages)[name]).parent).replace("\\", "/")
        for name in added_names
        if name in package_manifest_paths(head_packages)
    }
    if root_manifest_changed:
        if primary_package not in added_names or not root_manifest_is_mechanical(
            repo, args.base, args.head, new_manifest_paths
        ):
            raise ScopeError("root_manifest_scope", "root Cargo.toml is not a mechanical new-package registration")
        if new_manifest_paths != {str(Path(package_manifest_paths(head_packages)[primary_package]).parent).replace("\\", "/")}:
            raise ScopeError("root_manifest_scope", "root manifest registers more than primary package")
    if root_lock_changed:
        if lock_diff_has_unattributable_lines(repo, args.base, args.head):
            raise ScopeError("unattributable_lock_change", "Cargo.lock contains non-package or non-mechanical changes")
        lock_names = lock_change_names(repo, args.base, args.head)
        if not lock_names or primary_package is None or not lock_names.issubset({primary_package}):
            raise ScopeError("unattributable_lock_change", ", ".join(sorted(lock_names)) or "unknown lock change")
        expected_dependencies = metadata_dependency_names(head_metadata, primary_package)
        actual_dependencies = lock_dependency_names(repo, args.head, primary_package)
        if expected_dependencies is None or actual_dependencies is None:
            raise ScopeError("unattributable_lock_change", "workspace package lock dependency record is unavailable")
        if actual_dependencies != expected_dependencies:
            raise ScopeError(
                "unattributable_lock_change",
                f"Cargo.lock dependencies for {primary_package} do not match Cargo metadata",
            )
        if not lock_dependency_references_are_canonical(
            repo, args.head, primary_package, head_metadata
        ):
            raise ScopeError(
                "unattributable_lock_change",
                f"Cargo.lock dependency records for {primary_package} are duplicated or non-canonical",
            )
        metadata_identity = metadata_package(head_metadata, primary_package)
        lock_identity = lock_workspace_record(repo, args.head, primary_package)
        if metadata_identity is None or lock_identity is None:
            raise ScopeError("unattributable_lock_change", "workspace package lock identity is unavailable")
        if lock_identity.get("version") != metadata_identity.get("version"):
            raise ScopeError(
                "unattributable_lock_change",
                f"Cargo.lock version for {primary_package} does not match Cargo metadata",
            )
        if lock_identity.get("source") != metadata_identity.get("source"):
            raise ScopeError(
                "unattributable_lock_change",
                f"Cargo.lock source for {primary_package} does not match Cargo metadata",
            )

    active_build_packages = set(package_owners)
    while True:
        dependencies = {
            target for source, target, _ in head_dependency_edges
            if source in active_build_packages
        }
        expanded = active_build_packages | dependencies
        if expanded == active_build_packages:
            break
        active_build_packages = expanded
    check_cross_package_edges(
        repo, args.head, tracked_paths(repo, args.head), head_packages,
        set(normalized_paths), head_build_scripts, active_build_packages,
    )
    return {
        "status": "allowed",
        "primary_package": primary_package,
        "changed_paths": normalized_paths,
        "changed_packages": sorted(package_owners),
        "policy": policy_path,
        "policy_version": policy["policy_version"],
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo-root", required=True)
    parser.add_argument("--base", required=True)
    parser.add_argument("--head", required=True)
    parser.add_argument("--primary-package", required=True)
    parser.add_argument("--policy", required=True)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    try:
        payload = evaluate(args)
    except ScopeError as exc:
        payload = {"status": "rejected", "reason": exc.reason}
        if exc.detail:
            payload["detail"] = exc.detail
        if args.json:
            print(json.dumps(payload, sort_keys=True))
        else:
            print(f"rejected: {exc.reason}: {exc.detail}", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(payload, sort_keys=True))
    else:
        print(f"allowed: {args.primary_package}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
