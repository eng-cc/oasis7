{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oasis7.loop-change/v1",
  "title": "Oasis7 coordinating loop change record",
  "type": "object",
  "required": [
    "schema",
    "marker",
    "task_uid",
    "change_id",
    "coordination_ref",
    "required_obligations",
    "mapping_slots",
    "candidate_selection",
    "feedback"
  ],
  "properties": {
    "schema": {"const": "oasis7.loop-change/v1"},
    "marker": {"const": "oasis7-loop-change-record"},
    "task_uid": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"},
    "change_id": {"type": "string", "minLength": 1},
    "coordination_ref": {"$ref": "#/$defs/authority_ref"},
    "required_obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/obligation"}},
    "mapping_slots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping_slot"}},
    "candidate_selection": {"$ref": "#/$defs/candidate_selection"},
    "feedback": {"type": "array", "items": {"$ref": "#/$defs/feedback"}},
    "input_contracts": {"type": "array", "items": {"type": "object"}},
    "consumed_clause_refs": {"type": "array", "items": {"$ref": "#/$defs/bound_path_ref"}}
  },
  "$defs": {
    "authority_ref": {
      "type": "object",
      "required": ["repository", "issue_number", "comment_id", "record_digest", "source_commit"],
      "properties": {
        "repository": {"const": "eng-cc/oasis7"},
        "issue_number": {"type": "integer", "minimum": 1},
        "comment_id": {"type": "integer", "minimum": 1},
        "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "path_ref": {
      "type": "object",
      "required": ["repository", "path", "fragment"],
      "properties": {
        "repository": {"const": "eng-cc/oasis7"},
        "path": {"type": "string", "minLength": 1},
        "fragment": {"type": "string", "minLength": 1},
        "contract_id": {"type": "string", "minLength": 1},
        "revision": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]},
        "contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "publication_ref": {"$ref": "#/$defs/publication_ref"},
        "clause_id": {"type": "string", "minLength": 1}
      }
    },
    "bound_path_ref": {
      "allOf": [
        {"$ref": "#/$defs/path_ref"}
      ],
      "required": ["contract_id", "revision", "contract_digest", "publication_ref"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "obligation": {
      "type": "object",
      "required": ["obligation_id", "mapping_slot", "required", "acceptance_refs", "owner_loop", "owner_role"],
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "mapping_slot": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "acceptance_refs": {"type": "array", "minItems": 1, "items": {"anyOf": [{"$ref": "#/$defs/path_ref"}, {"type": "string", "minLength": 1}]}},
        "owner_loop": {"enum": ["product", "system", "code"]},
        "owner_role": {"type": "string", "minLength": 1}
      }
    },
    "mapping_slot": {
      "type": "object",
      "required": ["slot_id", "owner_loop", "owner_role"],
      "properties": {
        "slot_id": {"type": "string", "minLength": 1},
        "owner_loop": {"enum": ["product", "system", "code"]},
        "owner_role": {"type": "string", "minLength": 1},
        "allowed_task_uids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^task_[0-9a-f]{32}$"}}
      }
    },
    "publication_ref": {
      "type": "object",
      "required": ["repository", "issue_number", "comment_id"],
      "properties": {
        "repository": {"const": "eng-cc/oasis7"},
        "issue_number": {"type": "integer", "minimum": 1},
        "comment_id": {"type": "integer", "minimum": 1}
      }
    },
    "feedback": {
      "type": "object",
      "required": [
        "source_locator",
        "receiving_owner",
        "disposition_authority",
        "decision",
        "basis",
        "authorized_follow_up",
        "affected_consumer",
        "blocking",
        "clearance"
      ],
      "properties": {
        "source_locator": {"type": "string", "minLength": 1},
        "receiving_owner": {"type": "string", "minLength": 1},
        "disposition_authority": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "minLength": 1},
        "basis": {"type": "string", "minLength": 1},
        "authorized_follow_up": {"type": "string", "minLength": 1},
        "affected_consumer": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "clearance": {"type": ["object", "null"]}
      }
    },
    "candidate_selection": {
      "type": "object",
      "required": ["comparable_fields", "required_integration_base_oid", "required_tested_tree_oid"],
      "properties": {
        "comparable_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_integration_base_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "required_tested_tree_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "leaf_evidence_locator": {
      "type": "object",
      "required": ["repository", "issue_number", "comment_id", "body_digest"],
      "additionalProperties": false,
      "properties": {
        "repository": {"const": "eng-cc/oasis7"},
        "issue_number": {"type": "integer", "minimum": 1},
        "comment_id": {"type": "integer", "minimum": 1},
        "body_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "authority_map_ref": {
      "type": "object",
      "required": ["repository", "issue_number", "comment_id", "body_digest"],
      "additionalProperties": false,
      "properties": {
        "repository": {"const": "eng-cc/oasis7"},
        "issue_number": {"type": "integer", "minimum": 1},
        "comment_id": {"type": "integer", "minimum": 1},
        "body_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "leaf_result_candidate": {
      "type": "object",
      "required": [
        "change_id",
        "source_head_oid",
        "integration_base_oid",
        "tested_tree_oid",
        "configuration_digest",
        "entry",
        "environment",
        "evidence_window",
        "effective_policy_identity",
        "effective_helper_identity",
        "effective_workflow_identity",
        "consumed_contracts"
      ],
      "properties": {
        "change_id": {"type": "string", "minLength": 1},
        "source_head_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "integration_base_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tested_tree_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "configuration_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "entry": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "evidence_window": {"type": "object", "required": ["started_at", "ended_at"]},
        "effective_policy_identity": {"$ref": "#/$defs/effective_identity"},
        "effective_helper_identity": {"$ref": "#/$defs/effective_identity"},
        "effective_workflow_identity": {"$ref": "#/$defs/effective_identity"},
        "consumed_contracts": {"type": "array", "items": {"type": "object"}}
      }
    },
    "effective_identity": {
      "type": "object",
      "required": ["path", "commit"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
