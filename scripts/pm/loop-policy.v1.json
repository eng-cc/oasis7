{
  "schema": "oasis7.loop-policy/v1",
  "rules": [
    {"pattern": "**/AGENTS.md", "loop": "code"},
    {"pattern": "**/SKILL.md", "loop": "code"},
    {"pattern": "AGENTS.md", "loop": "code"},
    {"pattern": ".agents/**", "loop": "code"},
    {"pattern": ".codex/**", "loop": "code"},
    {"pattern": "skills/**", "loop": "code"},
    {"pattern": "doc/.governance/**", "loop": "code"},
    {"pattern": "doc/product/**", "loop": "product"},
    {"pattern": "doc/game/prd.md", "loop": "product"},
    {"pattern": "doc/game/prd.index.md", "loop": "product"},
    {"pattern": "doc/game/README.md", "loop": "product"},
    {"pattern": "doc/game/gameplay/README.md", "loop": "product"},
    {"pattern": "doc/game/gameplay/*.prd.md", "loop": "product"},
    {"pattern": "doc/game/gameplay/gameplay-indirect-control-agency-contract.design.md", "loop": "product"},
    {"pattern": "doc/game/gameplay/gameplay-war-politics-mvp-baseline.design.md", "loop": "product"},
    {"pattern": "doc/**", "loop": "system"},
    {"pattern": "README.md", "loop": "system"},
    {"pattern": "testing-manual.md", "loop": "system"},
    {"pattern": "src/**", "loop": "code"},
    {"pattern": "crates/**", "loop": "code"},
    {"pattern": "scripts/**", "loop": "code"},
    {"pattern": "tests/**", "loop": "code"},
    {"pattern": "benches/**", "loop": "code"},
    {"pattern": "examples/**", "loop": "code"},
    {"pattern": "assets/**", "loop": "code"},
    {"pattern": "config/**", "loop": "code"},
    {"pattern": "configs/**", "loop": "code"},
    {"pattern": "deploy/**", "loop": "code"},
    {"pattern": "web/**", "loop": "code"},
    {"pattern": "tools/**", "loop": "code"},
    {"pattern": "proto/**", "loop": "code"},
    {"pattern": ".github/**", "loop": "code"},
    {"pattern": "Cargo.toml", "loop": "code"},
    {"pattern": "Cargo.lock", "loop": "code"},
    {"pattern": "rust-toolchain.toml", "loop": "code"},
    {"pattern": "rustfmt.toml", "loop": "code"},
    {"pattern": ".gitignore", "loop": "code"},
    {"pattern": ".gitattributes", "loop": "code"},
    {"pattern": ".cargo/**", "loop": "code"},
    {"pattern": "package.json", "loop": "code"},
    {"pattern": "package-lock.json", "loop": "code"}
  ],
  "denied": ["third_party/**", ".git/**", ".pm/**"],
  "mixed_documents": ["doc/game/design.md", "doc/game/gameplay/gameplay-regional-infrastructure-micro-depot-contract.design.md", "doc/game/gameplay/gameplay-agent-claim-economy-contract.design.md", "doc/game/gameplay/gameplay-top-level-design.design.md"],
  "document_extensions": [".md", ".txt", ".rst", ".adoc", ".mmd", ".mermaid", ".png", ".jpg", ".jpeg", ".webp", ".svg", ".pdf"]
}
