#!/usr/bin/env python3
"""Bounded read-only validator service/listener observation.

This executable is the only production implementation of the
service-readback --read-only command used by the governed direct-SSH
provider. It accepts one code-owned validator role and target contract,
executes fixed read-only probes without a shell, and emits one strict JSON
object. It never starts, stops, restarts, resets, stages, deletes, or queries
the full chain-status endpoint.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import os
import stat
import subprocess
import sys
from pathlib import Path
from typing import NoReturn


CANONICAL_ROOT = "/opt/oasis7/p2p-testnet"
SERVICES = {
    "sequencer": {
        "service": "oasis7-triad-sequencer.service",
        "ports": frozenset({"6631", "6831"}),
    },
    "storage": {
        "service": "oasis7-triad-storage.service",
        "ports": frozenset({"6632", "6832"}),
    },
    "validator-47": {
        "service": "oasis7-triad-validator-47.service",
        "ports": frozenset({"6634", "6834"}),
    },
}
# The triad inventory is the code-owned authority for the validator-47
# service/port target.  Keep the expected digest in the operator executable so
# a copied or edited inventory can be rejected before readback is trusted.
TRIAD_INVENTORY_RELATIVE = "scripts/public-testnet-validator-triad-inventory.v1.json"
TRIAD_INVENTORY_FILE = "public-testnet-validator-triad-inventory.v1.json"
TRIAD_INVENTORY_SHA256 = "b983bd9df4f29bf7a0e32dd9d1d56323d85d16d4cf572c10bc8c567908565739"
TRIAD_SOURCE_REGISTRY_RELATIVE = "doc/testing/evidence/public-testnet-governed-bootstrap-validator-triad-registry-2026-09-15.json"
TRIAD_SOURCE_REGISTRY_SHA256 = "1296accdac21371a017797b29503aa6658ed600f71049db0599ae3d12c651510"
TRIAD_GENERATED_REGISTRY_RELATIVE = "config/public-testnet-governed-bootstrap-validator-registry-2026-06-06.json"
TRIAD_GENERATED_REGISTRY_SHA256 = "1290818e16b4d5f6fa1929a18e0d6c73295d0ff86e8c7ee8ee58e670874199fd"
TRIAD_GENERATED_REGISTRY_SEMANTIC_SHA256 = "82b3b705cc72173b34fc738f9cff00cba2f4cab0f05ca32ca58bf4dfd5ea7228"
TRIAD_BOOTSTRAP_PEER_RELATIVE = "doc/testing/evidence/public-testnet-governed-bootstrap-validator-triad-bootstrap-peers-2026-09-15.txt"
TRIAD_BOOTSTRAP_PEER_SHA256 = "5e62e5b132fe083c18c637213baefebad161c675e2243b2e02dc8bcd5f70401c"
TRIAD_RUNTIME_NODE_ROLE = "storage"
TRIAD_P2P_NODE_ROLE = "full_storage"
TRIAD_IDENTITY_KEY_FILE = "node-keypair.toml"
TRIAD_IDENTITY_RECEIPT_FILE = "identity-receipt.json"
READBACK_SCHEMA = "oasis7.human_direct_ssh_readback.v1"
COMMAND_TIMEOUT_SECONDS = 5
PORT_RE = re.compile(r":([0-9]{1,5})(?=\s|$)")
# macOS exposes these root-owned aliases while the temporary test fixtures and
# some local operator paths retain the lexical spelling.  They are allowed
# only when their raw link target is the exact system target; every other raw
# symlink component remains forbidden.
PLATFORM_ROOT_SYMLINK_TARGETS = {
    Path("/var"): "private/var",
    Path("/tmp"): "private/tmp",
}


def fail(message: str) -> NoReturn:
    print(f"error: service-readback: {message}", file=sys.stderr)
    raise SystemExit(2)


def regular_file(path: Path, label: str) -> os.stat_result:
    try:
        metadata = os.lstat(path)
    except OSError as error:
        fail(f"{label} is unavailable: {error.__class__.__name__}")
    if not stat.S_ISREG(metadata.st_mode):
        fail(f"{label} must be a regular file")
    return metadata


def _is_trusted_platform_root_alias(path: Path) -> bool:
    expected_target = PLATFORM_ROOT_SYMLINK_TARGETS.get(path)
    if expected_target is None:
        return False
    try:
        return os.readlink(path) == expected_target
    except OSError:
        return False


def _untrusted_raw_root_symlink(path: Path) -> Path | None:
    """Return a caller-controlled raw root component that is a symlink."""
    current = Path(path.anchor or "/")
    for component in path.parts[1:]:
        current /= component
        if current.is_symlink() and not _is_trusted_platform_root_alias(current):
            return current
    return None


def _physical_root_is_safe(root: str) -> None:
    """Require the canonical root and reject redirecting path components."""
    path = Path(root)
    if not path.exists():
        fail("canonical root does not exist")
    if not path.is_dir():
        fail("canonical root is not a directory")
    if _untrusted_raw_root_symlink(path) is not None:
        fail("root contains a symlink path component")


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="service-readback",
        allow_abbrev=False,
        description="Emit bounded read-only validator service state.",
    )
    parser.add_argument("--read-only", action="store_true", required=True)
    parser.add_argument("--role", choices=sorted(SERVICES), required=True)
    parser.add_argument("--root", required=True)
    parser.add_argument("--service", required=True)
    args = parser.parse_args(argv)
    if args.root != CANONICAL_ROOT:
        parser.error(f"--root must be exactly {CANONICAL_ROOT}")
    expected = SERVICES[args.role]
    if args.service != expected["service"]:
        parser.error(f"--service does not match --role {args.role}")
    # Validate the raw lexical path before resolve().  Otherwise a symlinked
    # parent component can redirect the canonical root and disappear from the
    # resolved path before the physical-root guard sees it.  Root-owned macOS
    # aliases are handled explicitly by _untrusted_raw_root_symlink().
    raw_root = Path(args.root)
    if raw_root.is_symlink():
        parser.error("--root must not be a symlink")
    symlink_component = _untrusted_raw_root_symlink(raw_root)
    if symlink_component is not None:
        parser.error(
            "--root must not contain a symlink path component: "
            f"{symlink_component}"
        )
    physical_root = raw_root.resolve(strict=True)
    _physical_root_is_safe(str(physical_root))
    args.root = str(physical_root)
    return args


def run_read_only(command: list[str], label: str) -> str:
    try:
        result = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=COMMAND_TIMEOUT_SECONDS,
            shell=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        fail(f"{label} read-only probe unavailable: {error.__class__.__name__}")
    if result.returncode != 0:
        fail(f"{label} read-only probe failed with exit {result.returncode}")
    return result.stdout


def inventory_descriptor(root: str) -> dict[str, str]:
    """Read the staged triad inventory when present and retain its digest."""
    path = Path(root) / "config" / TRIAD_INVENTORY_FILE
    regular_file(path, "triad inventory authority")
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    if digest != TRIAD_INVENTORY_SHA256:
        fail("triad inventory digest is not the canonical governed authority")
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        fail(f"triad inventory is malformed: {error.__class__.__name__}")
    target = payload.get("nodes", {}).get("validator-47") if isinstance(payload, dict) else None
    if not isinstance(target, dict):
        fail("triad inventory validator-47 binding missing")
    if (
        target.get("node_id") != "triad-testnet-validator-47"
        or target.get("service") != SERVICES["validator-47"]["service"]
        or target.get("roles") != ["validator", "checkpoint_provider", "full_storage_provider"]
        or target.get("ports") != ["6634", "6834"]
    ):
        fail("triad inventory validator-47 binding mismatch")
    authority = payload.get("authority")
    if not isinstance(authority, dict):
        fail("triad inventory authority metadata is missing")
    if authority.get("source_registry_ref") != TRIAD_SOURCE_REGISTRY_RELATIVE:
        fail("triad inventory source registry reference drift")
    if authority.get("source_registry_sha256") != TRIAD_SOURCE_REGISTRY_SHA256:
        fail("triad inventory source registry digest drift")
    if authority.get("generated_registry_sha256") != TRIAD_GENERATED_REGISTRY_SHA256:
        fail("triad inventory generated registry digest drift")
    if authority.get("generated_registry_semantic_sha256") != TRIAD_GENERATED_REGISTRY_SEMANTIC_SHA256:
        fail("triad inventory generated registry semantic digest drift")
    if authority.get("bootstrap_peer_ref") != TRIAD_BOOTSTRAP_PEER_RELATIVE:
        fail("triad inventory bootstrap peer reference drift")
    if authority.get("bootstrap_peer_sha256") != TRIAD_BOOTSTRAP_PEER_SHA256:
        fail("triad inventory bootstrap peer digest drift")
    source_path = Path(root) / "config" / TRIAD_SOURCE_REGISTRY_RELATIVE
    regular_file(source_path, "governed source validator registry")
    if hashlib.sha256(source_path.read_bytes()).hexdigest() != TRIAD_SOURCE_REGISTRY_SHA256:
        fail("governed source validator registry digest mismatch")
    generated_registry_path = Path(root) / TRIAD_GENERATED_REGISTRY_RELATIVE
    regular_file(generated_registry_path, "generated validator registry")
    if hashlib.sha256(generated_registry_path.read_bytes()).hexdigest() != TRIAD_GENERATED_REGISTRY_SHA256:
        fail("generated validator registry digest mismatch")
    try:
        generated_registry = json.loads(generated_registry_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, ValueError) as error:
        fail(f"generated validator registry is malformed: {error.__class__.__name__}")
    validators = generated_registry.get("validators") if isinstance(generated_registry, dict) else None
    if not isinstance(validators, list):
        fail("generated validator registry validators are missing")
    semantic_payload = {
        "signer_bindings": {
            f"governance.finality.v1.{item['node_id']}": str(item["finality_signer_public_key"]).lower()
            for item in validators
        },
        "slot_id": generated_registry.get("slot_id"),
        "threshold": generated_registry.get("threshold"),
        "threshold_bps": generated_registry.get("threshold_bps"),
        "validator_stakes": {
            f"governance.finality.v1.{item['node_id']}": item["stake"]
            for item in validators
        },
    }
    if hashlib.sha256(
        json.dumps(semantic_payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest() != TRIAD_GENERATED_REGISTRY_SEMANTIC_SHA256:
        fail("generated validator registry semantic digest mismatch")
    peer_path = Path(root) / "config" / "public-testnet-governed-bootstrap-bootstrap-peers-2026-06-06.txt"
    regular_file(peer_path, "governed bootstrap peer evidence")
    if hashlib.sha256(peer_path.read_bytes()).hexdigest() != TRIAD_BOOTSTRAP_PEER_SHA256:
        fail("governed bootstrap peer evidence digest mismatch")
    peer_lines = [line.strip() for line in peer_path.read_text(encoding="utf-8").splitlines() if line.strip()]
    if len(peer_lines) != 3:
        fail("governed bootstrap peer evidence must contain exactly three peers")
    for name, node in payload.get("nodes", {}).items():
        host = str(node.get("host", "")).removeprefix("root@")
        ports = node.get("ports")
        if not host or not isinstance(ports, list) or len(ports) < 2:
            fail(f"governed bootstrap peer inventory endpoint is incomplete: {name}")
        prefix = f"/ip4/{host}/tcp/{ports[1]}/p2p/"
        matches = [line for line in peer_lines if line.startswith(prefix)]
        if len(matches) != 1:
            fail(f"governed bootstrap peer topology mismatch: {name}")
        if node.get("libp2p_peer_id") and not matches[0].endswith(f"/p2p/{node['libp2p_peer_id']}"):
            fail(f"governed bootstrap peer identity mismatch: {name}")
    manifest_path = Path(root) / "config" / "public-testnet-governed-bootstrap-manifest-2026-06-06.json"
    regular_file(manifest_path, "validator-47 governed manifest")
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, ValueError) as error:
        fail(f"validator-47 governed manifest is malformed: {error.__class__.__name__}")
    if manifest.get("bootstrap_peer_authority") != {
        "ref": peer_path.name,
        "sha256": TRIAD_BOOTSTRAP_PEER_SHA256,
    }:
        fail("validator-47 manifest bootstrap peer authority mismatch")
    if manifest.get("deployment_validator_registry") != {
        "ref": TRIAD_GENERATED_REGISTRY_RELATIVE,
        "sha256": TRIAD_GENERATED_REGISTRY_SHA256,
        "semantic_sha256": TRIAD_GENERATED_REGISTRY_SEMANTIC_SHA256,
    }:
        fail("validator-47 manifest generated registry authority mismatch")
    env_path = Path(root) / "config" / "node.env"
    regular_file(env_path, "validator-47 node.env authority")
    values: dict[str, str] = {}
    try:
        env_lines = env_path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as error:
        fail(f"validator-47 node.env is unreadable: {error.__class__.__name__}")
    for line_number, raw_line in enumerate(env_lines, 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            fail(f"validator-47 node.env malformed line {line_number}")
        key, value = line.split("=", 1)
        if not key or key in values:
            fail(f"validator-47 node.env duplicate or empty key at line {line_number}")
        values[key] = value
    expected_env = {
        "NODE_ID": "triad-testnet-validator-47",
        "NODE_ROLE": TRIAD_RUNTIME_NODE_ROLE,
        "P2P_NODE_ROLE": TRIAD_P2P_NODE_ROLE,
        "GENESIS_VALIDATOR_REGISTRY_SHA256": TRIAD_GENERATED_REGISTRY_SHA256,
        "GENESIS_VALIDATOR_REGISTRY_SEMANTIC_SHA256": TRIAD_GENERATED_REGISTRY_SEMANTIC_SHA256,
        "CHECKPOINT_PROVIDER": "1",
        "FULL_STORAGE_PROVIDER": "1",
        "IDENTITY_KEY_PATH": "config/node-keypair.toml",
        "IDENTITY_RECEIPT_PATH": "config/identity-receipt.json",
    }
    if any(values.get(key) != expected for key, expected in expected_env.items()):
        fail("validator-47 node.env runtime/provider role binding mismatch")
    if values.get("DEPLOYMENT_INVENTORY_SHA256") != digest:
        fail("validator-47 node.env inventory digest mismatch")
    return {
        "ref": TRIAD_INVENTORY_RELATIVE,
        "sha256": digest,
        "source_registry_ref": TRIAD_SOURCE_REGISTRY_RELATIVE,
        "source_registry_sha256": TRIAD_SOURCE_REGISTRY_SHA256,
        "generated_registry_ref": TRIAD_GENERATED_REGISTRY_RELATIVE,
        "generated_registry_sha256": TRIAD_GENERATED_REGISTRY_SHA256,
        "generated_registry_semantic_sha256": TRIAD_GENERATED_REGISTRY_SEMANTIC_SHA256,
        "bootstrap_peer_ref": str(peer_path.relative_to(Path(root))),
        "bootstrap_peer_sha256": TRIAD_BOOTSTRAP_PEER_SHA256,
    }


def identity_descriptor(root: str, inventory: dict[str, str]) -> dict[str, object]:
    """Read the imported identity without exposing private key bytes."""
    config_dir = Path(root) / "config"
    key_path = config_dir / TRIAD_IDENTITY_KEY_FILE
    receipt_path = config_dir / TRIAD_IDENTITY_RECEIPT_FILE
    current = Path(config_dir.anchor or "/")
    for component in config_dir.parts[1:]:
        current /= component
        if current.is_symlink():
            fail("validator-47 config path contains a symlink component")
    try:
        config_metadata = os.lstat(config_dir)
    except OSError as error:
        fail(f"validator-47 config directory is unavailable: {error.__class__.__name__}")
    if not stat.S_ISDIR(config_metadata.st_mode):
        fail("validator-47 config directory is not a regular directory")
    values: dict[str, object] = {}
    for path, label in ((key_path, "identity key"), (receipt_path, "identity receipt")):
        metadata = regular_file(path, f"validator-47 {label}")
        if stat.S_IMODE(metadata.st_mode) != 0o600:
            fail(f"validator-47 {label} must have mode 0600")
        if (metadata.st_uid, metadata.st_gid) != (config_metadata.st_uid, config_metadata.st_gid):
            fail(f"validator-47 {label} ownership does not match config directory")
        values[label.replace(" ", "_")] = metadata
    registry_path = config_dir / "public-testnet-governed-bootstrap-validator-registry-2026-06-06.json"
    regular_file(registry_path, "validator-47 governed registry")
    try:
        receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
        registry = json.loads(registry_path.read_text(encoding="utf-8"))
        inventory_payload = json.loads((config_dir / TRIAD_INVENTORY_FILE).read_text(encoding="utf-8"))
    except (OSError, UnicodeError, ValueError) as error:
        fail(f"validator-47 identity/registry readback failed: {error.__class__.__name__}")
    if receipt.get("schema_version") != "oasis7.identity_provision.v1":
        fail("validator-47 identity receipt schema mismatch")
    if receipt.get("node_id") != "triad-testnet-validator-47":
        fail("validator-47 identity receipt node mismatch")
    if "private_key" in json.dumps(receipt, ensure_ascii=False).lower():
        fail("validator-47 identity receipt contains private key material")
    inventory_node = inventory_payload.get("nodes", {}).get("validator-47")
    if not isinstance(inventory_node, dict):
        fail("validator-47 inventory identity binding is missing")
    for field in ("root_public_key", "finality_public_key", "libp2p_peer_id"):
        if receipt.get(field) != inventory_node.get(field):
            fail(f"validator-47 identity does not match governed inventory: {field}")
    matches = [item for item in registry.get("validators", []) if item.get("node_id") == receipt.get("node_id")]
    if len(matches) != 1 or matches[0].get("finality_signer_public_key", "").lower() != receipt.get("finality_public_key", "").lower():
        fail("validator-47 public identity does not match governed registry")
    for field in ("root_public_key", "finality_public_key", "libp2p_peer_id"):
        if matches[0].get(field) != inventory_node.get(field):
            fail(f"validator-47 registry identity does not match governed inventory: {field}")
    key_digest = hashlib.sha256(key_path.read_bytes()).hexdigest()
    if inventory.get("sha256") != hashlib.sha256((config_dir / TRIAD_INVENTORY_FILE).read_bytes()).hexdigest():
        fail("validator-47 identity inventory binding changed")
    node_env = {}
    for raw_line in (config_dir / "node.env").read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            node_env[key] = value
    if node_env.get("IDENTITY_KEY_SHA256") != key_digest:
        fail("validator-47 node.env identity key digest mismatch")
    receipt_digest = hashlib.sha256(receipt_path.read_bytes()).hexdigest()
    if node_env.get("IDENTITY_RECEIPT_SHA256") != receipt_digest:
        fail("validator-47 node.env identity receipt digest mismatch")
    return {
        "key_path": str(key_path),
        "key_sha256": key_digest,
        "key_mode": f"{stat.S_IMODE(values['identity_key'].st_mode):04o}",
        "key_uid": values["identity_key"].st_uid,
        "key_gid": values["identity_key"].st_gid,
        "receipt_path": str(receipt_path),
        "receipt_sha256": receipt_digest,
        "node_id": receipt["node_id"],
        "finality_public_key": receipt["finality_public_key"],
        "libp2p_peer_id": receipt["libp2p_peer_id"],
        "owner_valid": True,
    }


def service_state(service: str, *, require_disabled: bool = False) -> tuple[bool, bool, str, str]:
    output = run_read_only(
        [
            "systemctl",
            "show",
            "--no-page",
            "--property=ActiveState",
            "--property=LoadState",
            "--property=SubState",
            "--property=NRestarts",
            "--property=UnitFileState",
            "--property=MainPID",
            service,
        ],
        "service",
    )
    values: dict[str, str] = {}
    for line in output.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key] = value.strip()
    if not {"LoadState", "ActiveState", "SubState", "NRestarts", "UnitFileState", "MainPID"}.issubset(values):
        fail("service read-only probe returned incomplete state")
    if values["LoadState"] != "loaded":
        fail("service unit is not loaded")
    try:
        restarts = int(values["NRestarts"])
    except ValueError:
        fail("service read-only probe returned malformed restart count")
    if restarts != 0:
        fail("service read-only probe reports a nonzero restart count")
    active_state = values["ActiveState"]
    sub_state = values["SubState"]
    main_pid = values["MainPID"]
    if not re.fullmatch(r"[0-9]+", main_pid):
        fail("service read-only probe returned malformed MainPID")
    if require_disabled:
        # validator-47 is staged but must never be started.  Keep this strict
        # no-start gate independent from the active service contract below.
        if active_state != "inactive" or sub_state != "dead":
            fail("validator-47 service unit is not in the expected inactive/dead state")
    elif (active_state, sub_state) not in {
        ("inactive", "dead"),
        ("active", "running"),
    }:
        # These Type=simple chain services are either live/running or
        # stopped/dead. Unknown, socket-like, and oneshot-like combinations
        # remain fail-closed instead of being flattened into a guessed state.
        fail("service unit has an unsupported active/substate combination")
    if active_state == "active" and int(main_pid) <= 0:
        fail("active service unit has no valid MainPID")
    if require_disabled and values["UnitFileState"] != "disabled":
        fail("validator-47 service unit is not disabled")
    active = active_state == "active"
    running = active and sub_state == "running"
    return active, running, values["UnitFileState"], main_pid


def process_running(main_pid: str, root: str) -> bool:
    """Detect the unit process and stack-local orphans with bounded probes.

    MainPID alone is insufficient after an unclean stop: systemd may report 0
    while a detached start-node/runtime child still owns the stack. The
    second probe is deliberately narrow: it only treats a command line as an
    orphan when it contains the exact managed root and one of the two
    code-owned launch markers. It therefore does not turn unrelated oasis7
    processes elsewhere on the host into a validator-47 failure.
    """
    if main_pid and main_pid != "0":
        if not main_pid.isdigit():
            fail("service read-only probe returned malformed MainPID")
        output = run_read_only(["ps", "-p", main_pid, "-o", "args="], "process")
        if output.strip():
            return True
    output = run_read_only(["ps", "-eo", "pid=,args="], "orphan process")
    marker_tokens = ("/bin/start-node.sh", "/bin/oasis7_chain_runtime")
    for line in output.splitlines():
        if not line.strip() or root not in line:
            continue
        if any(marker in line for marker in marker_tokens):
            return True
    return False


def listener_ports(expected_ports: frozenset[str]) -> list[str]:
    output = run_read_only(["ss", "-ltn"], "listener")
    observed = {port for port in PORT_RE.findall(output) if port in expected_ports}
    return sorted(observed, key=int)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(list(sys.argv[1:] if argv is None else argv))
    expected = SERVICES[args.role]
    require_disabled = args.role == "validator-47"
    active, service_running, unit_file_state, main_pid = service_state(
        args.service, require_disabled=require_disabled
    )
    process_is_running = process_running(main_pid, args.root)
    listeners = listener_ports(expected["ports"])
    running = service_running or process_is_running or bool(listeners)
    payload = {
        "schema_version": READBACK_SCHEMA,
        "active": active,
        "running": running,
        "service_state": "running" if running else "stopped",
        "independently_observed": True,
        "listeners": listeners,
    }
    if args.role == "validator-47":
        if process_is_running:
            fail("validator-47 no-start contract has a running process")
        if listeners:
            fail("validator-47 no-start contract has a listener")
        inventory = inventory_descriptor(args.root)
        identity = identity_descriptor(args.root, inventory)
        payload.update(
            {
                "unit_file_state": unit_file_state,
                "no_process": not process_is_running,
                "no_listener": not bool(listeners),
                "inventory": inventory,
                "identity": identity,
            }
        )
    print(json.dumps(payload, ensure_ascii=True, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
